{
  "name": "cowface",
  "version": "0.1.0",
  "description": "CowFace: marketplace de ropa, zapatos y bolsos en Costa Rica con ofertas y chat en vivo.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.1",
    "express": "^5.3.0",
    "multer": "^2.4.0"
  }
}
