<%- include('partials/header') %>
<% if (storePromo) { %><div class="promo-banner">🔥 <strong><%= storePromo.label || 'Promo' %>:</strong> <%= storePromo.pct %> % de descuento en toda la tienda<%= storePromo.until ? ` ${untilLabel(storePromo.until)}` : '' %></div><% } %>
<section class="profile-head">
  <div class="avatar avatar-lg"><%= profile.store_name.charAt(0).toUpperCase() %></div>
  <div class="profile-main">
    <h1><%= profile.store_name %></h1>
    <div class="profile-rating">
      <% if (rating.count) { %>
        <span class="stars" aria-label="<%= rating.avg.toFixed(1) %> de 5"><%= stars(rating.avg) %></span>
        <strong><%= rating.avg.toFixed(1) %></strong>
        <span class="muted">(<%= rating.count %> reseña<%= rating.count === 1 ? '' : 's' %>)</span>
      <% } else { %>
        <span class="muted">Sin reseñas todavía</span>
      <% } %>
    </div>
    <div class="profile-facts muted small">
      <span><%= profile.province %></span>
      <span>En <%= siteName %> desde <%= when(profile.created_at, true).replace(/,.*$/, '') %></span>
      <span><strong><%= sales.total %></strong> venta<%= sales.total === 1 ? '' : 's' %></span>
      <span><%= profile.purchases %> compra<%= profile.purchases === 1 ? '' : 's' %></span>
    </div>
    <div class="status-line"><%- include('partials/presence', { presence, hoursStatus: hoursInfo.status }) %></div>
    <% if (sales.base || rating.imported) { %>
      <p class="history-note muted small">
        Incluye historial de antes de <%= siteName %><%= sales.source ? ` (${sales.source})` : '' %>:
        <%= [sales.base ? `${sales.base} venta${sales.base === 1 ? '' : 's'}` : null, rating.imported ? `${rating.imported.count} reseña${rating.imported.count === 1 ? '' : 's'} (★ ${rating.imported.avg.toFixed(1)})` : null].filter(Boolean).join(' y ') %>.
        En <%= siteName %>: <%= sales.platform %> venta<%= sales.platform === 1 ? '' : 's' %>.
      </p>
    <% } %>
  </div>
  <div class="profile-actions">
    <% if (isMe) { %>
      <a class="btn btn-ghost btn-small" href="/vendedor">Mi cuenta</a>
    <% } else if (user && user.role === 'usuario') { %>
      <% if (iBlocked) { %>
        <form action="/u/<%= profile.id %>/desbloquear" method="post"><button class="btn btn-ghost btn-small">Desbloquear</button></form>
      <% } else { %>
        <form action="/u/<%= profile.id %>/bloquear" method="post" data-confirm="¿Bloquear a <%= profile.store_name %>? No podrán escribirse ni hacer tratos, y no verás sus artículos.">
          <button class="btn btn-danger btn-small">Bloquear</button>
        </form>
      <% } %>
    <% } %>
  </div>
</section>

<% if (blockedEither) { %>
  <div class="notice"><%= iBlocked ? 'Bloqueaste a esta persona.' : 'No puedes ver los artículos de esta persona.' %></div>
<% } %>

<% if (rating.count) { %>
  <div class="rating-split">
    <div><span class="muted small">Como vendedor</span><strong><%= rating.asSeller.count ? `${stars(rating.asSeller.avg)} ${rating.asSeller.avg.toFixed(1)}` : '—' %></strong><span class="muted small"><%= rating.asSeller.count %> reseña<%= rating.asSeller.count === 1 ? "" : "s" %></span></div>
    <div><span class="muted small">Como comprador</span><strong><%= rating.asBuyer.count ? `${stars(rating.asBuyer.avg)} ${rating.asBuyer.avg.toFixed(1)}` : '—' %></strong><span class="muted small"><%= rating.asBuyer.count %> reseña<%= rating.asBuyer.count === 1 ? "" : "s" %></span></div>
  </div>
<% } %>

<% if (hoursInfo.status.has) { %>
<section>
  <div class="section-head"><h2>Horario de atención</h2></div>
  <table class="hours-table"><tbody>
    <% for (const r of hoursInfo.table) { %><tr><td><%= r.label %></td><td class="<%= r.text === 'Cerrado' ? 'muted' : '' %>"><%= r.text %></td></tr><% } %>
  </tbody></table>
</section>
<% } %>

<section>
  <div class="section-head"><h2>Artículos (<%= listings.length %>)</h2></div>
  <% if (listings.length) { %>
    <div class="grid">
      <% for (const p of listings) { %><%- include('partials/card', { p }) %><% } %>
    </div>
  <% } else { %>
    <p class="muted">No hay artículos publicados.</p>
  <% } %>
</section>

<% if (!isMe) { %><%- include('partials/report', { type: 'usuario', id: profile.id, label: 'esta cuenta', back: `/u/${profile.id}` }) %><% } %>

<section id="resenas">
  <div class="section-head"><h2>Reseñas (<%= reviews.length %>)</h2></div>
  <% if (!reviews.length) { %>
    <p class="muted">Cuando complete compras o ventas en <%= siteName %>, sus reseñas aparecen aquí.</p>
  <% } else { %>
    <div class="review-list">
      <% for (const r of reviews) { %>
        <article class="review">
          <div class="review-head">
            <span class="stars"><%= stars(r.rating) %></span>
            <span class="status"><%= r.role === 'vendedor' ? 'Como vendedor' : 'Como comprador' %></span>
            <span class="muted small"><%= timeAgo(r.created_at) %></span>
          </div>
          <% if (r.comment) { %><p><%= r.comment %></p><% } %>
          <div class="muted small"><a href="/u/<%= r.author_id %>"><%= r.author_display %></a> · <%= r.product_title %></div>
        </article>
      <% } %>
    </div>
  <% } %>
</section>
<%- include('partials/footer') %>
