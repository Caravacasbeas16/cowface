<%- include('partials/header') %>
<%# Página de la tienda, como la de una tienda en DoorDash: portada, logo, datos, secciones por tipo y buscador. %>
<section class="store-hero <%= profile.store_banner ? 'has-banner' : '' %>">
  <div class="store-banner">
    <% if (profile.store_banner) { %><img src="/fotos/<%= profile.store_banner %>" alt=""><% } %>
  </div>
  <div class="store-id">
    <%- include('partials/store-logo', { name: profile.store_name, logo: profile.store_logo, size: 'lg' }) %>
    <div class="store-id-main">
      <h1><%= profile.store_name %><% if (verified) { %> <span class="verified" title="CowFace revisó fotos de sus productos y de envíos que ha hecho antes de aprobarla">✓ Verificada</span><% } %></h1>
      <div class="store-stats">
        <% if (rating.count) { %><span><span class="stars" aria-label="<%= rating.avg.toFixed(1) %> de 5"><%= stars(rating.avg) %></span> <strong><%= rating.avg.toFixed(1) %></strong> <span class="muted">(<%= rating.count %>)</span></span><% } else { %><span class="muted">Sin reseñas todavía</span><% } %>
        <span><strong><%= sales.total %></strong> venta<%= sales.total === 1 ? '' : 's' %></span>
        <span><strong data-followers><%= followers %></strong> seguidor<%= followers === 1 ? '' : 'es' %></span>
        <span class="muted"><%= profile.province %></span>
        <span class="muted">Desde <%= when(profile.created_at, true).replace(/,.*$/, '') %></span>
      </div>
      <div class="status-line"><%- include('partials/presence', { presence, hoursStatus: hoursInfo.status }) %><% if (reply) { %><span class="hours-pill">⚡ <%= reply %></span><% } %></div>
    </div>
    <div class="store-actions">
      <% if (isMe) { %>
        <a class="btn btn-small" href="/vendedor">Mi tienda</a>
        <a class="btn btn-ghost btn-small" href="/vendedor/configuracion#perfil">Editar</a>
      <% } else if (user && user.role === 'usuario' && !blockedEither) { %>
        <form action="/u/<%= profile.id %>/<%= following ? 'dejar-de-seguir' : 'seguir' %>" method="post" data-follow>
          <button class="btn btn-small <%= following ? 'btn-ghost' : '' %>" aria-pressed="<%= following %>"><%= following ? '✓ Siguiendo' : '+ Seguir' %></button>
        </form>
      <% } else if (!user) { %>
        <a class="btn btn-small" href="/entrar?next=/u/<%= profile.id %>">+ Seguir</a>
      <% } %>
    </div>
  </div>
</section>

<% if (profile.store_paused) { %><div class="notice"><strong>⏸ Tienda en pausa:</strong> «<%= profile.store_paused %>». Puedes ver sus artículos, pero por ahora no se puede comprar.</div><% } %>
<% if (storePromo) { %><div class="promo-banner">🔥 <strong><%= storePromo.label || 'Promo' %>:</strong> <%= storePromo.pct %> % de descuento en toda la tienda<%= storePromo.until ? ` ${untilLabel(storePromo.until)}` : '' %></div><% } %>
<% if (blockedEither) { %><div class="notice"><%= iBlocked ? 'Bloqueaste a esta persona.' : 'No puedes ver los artículos de esta persona.' %></div><% } %>

<div class="store-layout">
  <div class="store-content">
    <% if (profile.store_about) { %><p class="store-about"><%= profile.store_about %></p><% } %>

    <% if (listings.length) { %>
      <div class="store-toolbar">
        <input type="search" placeholder="Buscar en <%= profile.store_name %>" aria-label="Buscar en esta tienda" data-store-search>
        <select aria-label="Ordenar" data-store-sort>
          <option value="">Destacados</option>
          <option value="recientes">Más recientes</option>
          <option value="precio_asc">Precio: menor a mayor</option>
          <option value="precio_desc">Precio: mayor a menor</option>
        </select>
      </div>
      <nav class="store-tabs" aria-label="Secciones de la tienda" data-store-tabs>
        <a href="#todo" class="is-active">Todo <span><%= listings.length %></span></a>
        <% if (popular.length) { %><a href="#populares">⭐ Popular</a><% } %>
        <% if (onSale.length) { %><a href="#ofertas">🔥 Ofertas <span><%= onSale.length %></span></a><% } %>
        <% for (const g of groups) { %><a href="#<%= g.slug %>"><%= g.type %> <span><%= g.items.length %></span></a><% } %>
        <% if (sold.length) { %><a href="#vendidos">Vendidos</a><% } %>
      </nav>
      <span id="todo"></span>
      <p class="muted small" data-store-empty hidden>Nada coincide con tu búsqueda en esta tienda.</p>
      <% if (popular.length) { %>
        <section class="store-section" id="populares" data-store-section>
          <h2>⭐ Lo más popular</h2>
          <div class="grid"><% for (const p of popular) { %><%- include('partials/card', { p }) %><% } %></div>
        </section>
      <% } %>
      <% if (onSale.length && groups.length > 1) { %>
        <section class="store-section" id="ofertas" data-store-section>
          <h2>🔥 Ofertas</h2>
          <div class="grid"><% for (const p of onSale) { %><%- include('partials/card', { p }) %><% } %></div>
        </section>
      <% } %>
      <% for (const g of groups) { %>
        <section class="store-section" id="<%= g.slug %>" data-store-section>
          <h2><%= g.type %> <span class="muted small">(<%= g.items.length %>)</span></h2>
          <div class="grid"><% for (const p of g.items) { %><%- include('partials/card', { p }) %><% } %></div>
        </section>
      <% } %>
    <% } else if (!blockedEither) { %>
      <p class="muted">No hay artículos a la venta en este momento.<% if (!isMe && user) { %> Sigue la tienda y te avisamos cuando publique.<% } %></p>
    <% } %>

    <% if (sold.length) { %>
      <section class="store-section store-sold" id="vendidos">
        <h2>Vendidos recientemente</h2>
        <div class="grid">
          <% for (const p of sold) { %>
            <a class="card is-sold" href="/p/<%= p.id %>">
              <div class="card-img"><img src="<%= imageUrl(p) %>" alt="<%= p.title %>" loading="lazy"><span class="tag">Vendido</span></div>
              <div class="card-body"><div class="card-brand"><%= p.brand || p.item_type %></div><div class="card-title"><%= p.title %></div><div class="card-price"><%= money(p.price) %></div></div>
            </a>
          <% } %>
        </div>
      </section>
    <% } %>

    <section id="resenas">
      <div class="section-head"><h2>Reseñas (<%= reviews.length %>)</h2></div>
      <% if (rating.count) { %>
        <div class="rating-split">
          <div><span class="muted small">Como vendedor</span><strong><%= rating.asSeller.count ? `${stars(rating.asSeller.avg)} ${rating.asSeller.avg.toFixed(1)}` : '—' %></strong><span class="muted small"><%= rating.asSeller.count %> reseña<%= rating.asSeller.count === 1 ? "" : "s" %></span></div>
          <div><span class="muted small">Como comprador</span><strong><%= rating.asBuyer.count ? `${stars(rating.asBuyer.avg)} ${rating.asBuyer.avg.toFixed(1)}` : '—' %></strong><span class="muted small"><%= rating.asBuyer.count %> reseña<%= rating.asBuyer.count === 1 ? "" : "s" %></span></div>
        </div>
      <% } %>
      <% if (sales.base || rating.imported) { %>
        <p class="history-note muted small">
          Incluye historial de antes de <%= siteName %><%= sales.source ? ` (${sales.source})` : '' %>:
          <%= [sales.base ? `${sales.base} venta${sales.base === 1 ? '' : 's'}` : null, rating.imported ? `${rating.imported.count} reseña${rating.imported.count === 1 ? '' : 's'} (★ ${rating.imported.avg.toFixed(1)})` : null].filter(Boolean).join(' y ') %>.
          En <%= siteName %>: <%= sales.platform %> venta<%= sales.platform === 1 ? '' : 's' %>.
        </p>
      <% } %>
      <% if (!reviews.length) { %>
        <p class="muted">Cuando complete compras o ventas en <%= siteName %>, sus reseñas aparecen aquí.</p>
      <% } else { %>
        <div class="review-list">
          <% for (const r of reviews) { %>
            <article class="review">
              <div class="review-head">
                <span class="stars"><%= stars(r.rating) %></span>
                <span class="status"><%= r.role === 'vendedor' ? 'Como vendedor' : 'Como comprador' %></span>
                <span class="muted small"><%= timeAgo(r.created_at) %></span>
              </div>
              <% if (r.comment) { %><p><%= r.comment %></p><% } %>
              <div class="muted small"><a href="/u/<%= r.author_id %>"><%= r.author_display %></a> · <%= r.product_title %></div>
            </article>
          <% } %>
        </div>
      <% } %>
    </section>
  </div>

  <aside class="store-side">
    <% if (hoursInfo.status.has) { %>
      <div class="side-box">
        <h3>Horario de atención</h3>
        <table class="hours-table"><tbody>
          <% for (const r of hoursInfo.table) { %><tr><td><%= r.label %></td><td class="<%= r.text === 'Cerrado' ? 'muted' : '' %>"><%= r.text %></td></tr><% } %>
        </tbody></table>
      </div>
    <% } %>
    <div class="side-box">
      <h3>Entrega</h3>
      <p class="small">🚚 Correos de Costa Rica o Mensajería CowFace dentro del GAM</p>
      <% if (pickupPoints.length) { %>
        <p class="small">📍 Pick up:</p>
        <ul class="small pickup-list"><% for (const pt of pickupPoints) { %><li><%= pt %></li><% } %></ul>
      <% } %>
      <p class="hint">🛡️ Compra protegida: le pagas a CowFace y la tienda recibe el dinero cuando confirmas que te llegó.</p>
    </div>
    <div class="side-box side-links">
      <% if (!isMe) { %><%- include('partials/report', { type: 'usuario', id: profile.id, label: 'esta cuenta', back: `/u/${profile.id}` }) %><% } %>
      <% if (!isMe && user && user.role === 'usuario') { %>
        <% if (iBlocked) { %>
          <form action="/u/<%= profile.id %>/desbloquear" method="post"><button class="linklike small">Desbloquear</button></form>
        <% } else { %>
          <form action="/u/<%= profile.id %>/bloquear" method="post" data-confirm="¿Bloquear a <%= profile.store_name %>? No podrán escribirse ni hacer tratos, y no verás sus artículos.">
            <button class="linklike small">Bloquear esta cuenta</button>
          </form>
        <% } %>
      <% } %>
    </div>
  </aside>
</div>
<%- include('partials/footer') %>
