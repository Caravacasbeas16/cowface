<%- include('../partials/header') %>
<div class="portal">
<%- include('../partials/admin-nav', { adminActive: 'inicio' }) %>
<div class="portal-main">
<div class="page-head">
  <div>
    <h1>Administración</h1>
    <p class="muted">Lo que hay que hacer hoy, pedidos, usuarios y la configuración.</p>
  </div>
  <nav class="admin-links">
    <a class="btn btn-small" href="/admin/pagos">Pagos de hoy</a>
    <a class="btn btn-small btn-ghost" href="/admin/tiendas">Tiendas</a>
    <a class="btn btn-small btn-ghost" href="#notificaciones">Notificaciones</a>
    <a class="btn btn-small btn-ghost" href="#respaldos">Respaldos</a>
  </nav>
</div>

<% if (!pay.phone || !pay.holder) { %>
  <div class="notice"><strong>Falta configurar el cobro.</strong> Mientras no pongas tu número SINPE Móvil abajo, nadie puede comprar. <a href="#config">Configurar</a></div>
<% } %>

<div class="stats">
  <div class="stat stat-warn"><span class="stat-n"><%= money(totals.held) %></span><span class="muted">Dinero retenido (de compradores y vendedores)</span></div>
  <div class="stat stat-accent"><span class="stat-n"><%= money(totals.commission) %></span><span class="muted">Comisión ganada · <a href="/admin/ganancias">ver por mes</a></span></div>
  <div class="stat"><span class="stat-n"><%= money(totals.gmv) %></span><span class="muted">Ventas completadas (<%= totals.completed %>)</span></div>
  <div class="stat"><span class="stat-n"><%= totals.users %></span><span class="muted">Usuarios</span></div>
  <div class="stat"><span class="stat-n"><%= totals.products %></span><span class="muted">Artículos activos</span></div>
  <div class="stat"><span class="stat-n"><%= totals.offers %></span><span class="muted">Ofertas</span></div>
  <div class="stat <%= totals.flagged_week ? 'stat-warn' : '' %>"><span class="stat-n"><%= totals.flagged_week %></span><span class="muted">Intentos bloqueados (7 días)</span></div>
</div>

<section id="pagos">
  <h2>Por hacer</h2>
  <% const empty = !reports.length && !helpRequests.length && !storesToApprove.length && !queues.toVerify.length && !queues.toShip.length && !queues.disputes.length && !queues.refunds.length && !queues.payouts.length; %>
  <% if (empty) { %><p class="muted">Todo al día. 🎉</p><% } %>

  <% if (reports.length) { %>
    <h3 id="reportes">🚩 Reportes <span class="badge"><%= reports.length %></span></h3>
    <p class="hint">Revisa lo reportado y decide. La persona reportada no sabe quién la reportó.</p>
    <div class="task-list">
      <% for (const r of reports) { %>
        <div class="task task-ship">
          <div class="task-main">
            <strong><%= r.reasonLabel %></strong> · <%= r.target_type === 'articulo' ? 'Artículo' : r.target_type === 'usuario' ? 'Cuenta' : 'Conversación' %>: <a href="<%= r.link %>"><%= r.targetLabel %></a>
            <div class="muted small">Reportó <%= r.reporter_name %> · <%= when(r.created_at, true) %><%= r.reported ? ` · cuenta reportada: ${r.reported.name}${r.reported.active ? '' : ' (suspendida)'}` : '' %></div>
            <% if (r.details) { %><div class="flag-body">«<%= r.details %>»</div><% } %>
          </div>
          <div class="ship-actions">
            <% if (r.target_type === 'articulo') { %><form action="/admin/reportes/<%= r.id %>/ocultar" method="post" data-confirm="¿Ocultar este artículo? La tienda no podrá volver a publicarlo."><button class="btn btn-small">Ocultar artículo</button></form><% } %>
            <% if (r.reported && r.reported.active) { %><form action="/admin/reportes/<%= r.id %>/suspender" method="post" data-confirm="¿Suspender la cuenta de <%= r.reported.name %>? Se cierra su sesión y no puede entrar."><button class="btn btn-small btn-danger">Suspender cuenta</button></form><% } %>
            <form action="/admin/reportes/<%= r.id %>/descartar" method="post"><button class="btn btn-small btn-ghost">Descartar</button></form>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (helpRequests.length) { %>
    <h3 id="ayuda">🛟 Ayuda solicitada <span class="badge"><%= helpRequests.length %></span></h3>
    <p class="hint">Te pidieron que te hagas cargo. Lee la conversación, escríbeles como CowFace y márcalo resuelto.</p>
    <div class="task-list">
      <% for (const h of helpRequests) { %>
        <div class="task task-ship">
          <div class="task-main">
            <strong><%= h.who %></strong> · «<%= h.product_title || 'conversación' %>»<%= h.order_code ? ` · pedido ${h.order_code} (${ORDER_STATUS[h.order_status] || h.order_status})` : '' %>
            <div class="muted small"><%= h.email %> · <%= when(h.created_at, true) %></div>
            <div class="flag-body">«<%= h.body %>»</div>
            <% if (h.conversation_id) { %><a class="file-link" href="/admin/conversaciones/<%= h.conversation_id %>">Abrir la conversación y responder</a><% } %>
          </div>
          <form action="/admin/ayuda/<%= h.id %>/resolver" method="post" class="reject-form">
            <input name="note" maxlength="1000" placeholder="Cómo se resolvió (opcional; lo ven en el chat)" aria-label="Cómo se resolvió">
            <button class="btn btn-small">Marcar resuelto</button>
          </form>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (storesToApprove.length) { %>
    <h3 id="tiendas-por-aprobar">Tiendas por aprobar <span class="badge"><%= storesToApprove.length %></span></h3>
    <p class="hint">Pidieron permiso para vender. Revisa su Instagram y lo que van a vender; mientras esperan pueden ir guardando borradores.</p>
    <div class="task-list">
      <% for (const t of storesToApprove) { %>
        <%- include('request-card', { t }) %>
      <% } %>
    </div>
  <% } %>

  <% if (queues.toVerify.length) { %>
    <h3>1. Pagos por verificar <span class="badge"><%= queues.toVerify.length %></span></h3>
    <p class="hint">Revisa en tu app del banco que entró el SINPE por el monto exacto con este detalle. Si está, confírmalo y el vendedor recibe aviso para enviar.</p>
    <div class="task-list">
      <% for (const o of queues.toVerify) { %>
        <div class="task">
          <div class="task-main">
            <strong><%= o.code %></strong> · debe entrar <strong><%= money(o.total || o.price) %></strong> · pagó <strong><%= o.payer_name || o.payment_reference %></strong>
            <% if (o.payment_proof) { %> · <a class="file-link" href="/adjuntos/<%= o.payment_proof %>" target="_blank" rel="noopener">Ver captura</a><% } %>
            <div class="muted small"><%= o.buyer_name %> compra «<%= o.product_title %>» a <%= o.store_name %> · <%= DELIVERY_METHODS[o.delivery_method] || '' %><%= o.shipping_cost ? ` (envío ${money(o.shipping_cost)})` : '' %> · avisó <%= when(o.payment_reported_at, true) %></div>
          </div>
          <form action="/admin/pedidos/<%= o.id %>/confirmar-pago" method="post" data-confirm="¿Confirmas que recibiste <%= money(o.total || o.price) %> con el detalle <%= o.code %>?"><button class="btn btn-small">Pago recibido</button></form>
          <form action="/admin/pedidos/<%= o.id %>/rechazar-pago" method="post" data-confirm="¿Avisar al comprador que no encontraste el pago?"><button class="btn btn-small btn-ghost">No lo encuentro</button></form>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (queues.toShip.length) { %>
    <h3 id="envios">Datos por enviar a tiendas <span class="badge"><%= queues.toShip.filter((o) => !o.data_sent_at).length || '' %></span></h3>
    <p class="hint">Pagos ya confirmados. Mándale a la tienda los datos de entrega por correo, o cópialos y pégalos en WhatsApp (y márcalos como enviados). La tienda también los ve en el pedido.</p>
    <div class="task-list">
      <% for (const o of queues.toShip) { %>
        <% const text = orderDataText(o, siteUrl); %>
        <div class="task task-ship">
          <div class="task-main">
            <strong><%= o.code %></strong> · <%= o.store_name %> → <%= o.buyer_name %> · <%= DELIVERY_METHODS[o.delivery_method] || '' %>
            <% if (o.data_sent_at) { %><span class="status status-vendido">Datos enviados <%= when(o.data_sent_at, true) %></span><% } else { %><span class="status status-por_pagar">Sin enviar</span><% } %>
            <pre class="ship-data copy" data-copy="<%= text %>" title="Toca para copiar"><%= text %></pre>
          </div>
          <div class="ship-actions">
            <form action="/admin/pedidos/<%= o.id %>/enviar-datos" method="post"><button class="btn btn-small"><%= o.data_sent_at ? 'Reenviar por correo' : 'Mandar por correo' %></button></form>
            <button class="btn btn-small btn-ghost" type="button" data-copy="<%= text %>">Copiar para WhatsApp</button>
            <% if (isCourier(o.delivery_method) && wazeLink(o)) { %><a class="btn btn-small btn-ghost" href="<%= wazeLink(o) %>" target="_blank" rel="noopener">🚗 Abrir en Waze</a><% } %>
            <% if (!o.data_sent_at) { %><form action="/admin/pedidos/<%= o.id %>/datos-enviados" method="post"><button class="btn btn-small btn-ghost">Ya se los mandé</button></form><% } %>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (queues.disputes.length) { %>
    <h3>2. Reclamos <span class="badge"><%= queues.disputes.length %></span></h3>
    <p class="hint">Lee la conversación con las dos partes antes de decidir. El dinero sigue retenido mientras tanto.</p>
    <div class="task-list">
      <% for (const o of queues.disputes) { %>
        <div class="task">
          <div class="task-main">
            <strong><%= o.code %></strong> · <%= money(o.total || o.price) %> · <%= o.store_name %> → <%= o.buyer_name %>
            <div class="flag-body">«<%= o.dispute_reason %>»</div>
            <div class="muted small">
              <%= o.shipped_at ? `Enviado ${when(o.shipped_at, true)}${o.shipping_note ? ` · «${o.shipping_note}»` : ''}` : 'Sin marcar como enviado' %>
              <% if (o.dispute_evidence) { %> · <a class="file-link" href="/adjuntos/<%= o.dispute_evidence %>" target="_blank" rel="noopener">Evidencia del comprador</a><% } %>
              <% if (o.shipping_proof) { %> · <a class="file-link" href="/adjuntos/<%= o.shipping_proof %>" target="_blank" rel="noopener">Comprobante de envío</a><% } %>
              <% if (o.conversation_id) { %> · <a class="file-link" href="/admin/conversaciones/<%= o.conversation_id %>">Leer la conversación</a><% } %>
            </div>
          </div>
          <form action="/admin/pedidos/<%= o.id %>/liberar" method="post" data-confirm="¿Resolver a favor del vendedor y liberarle el pago?"><button class="btn btn-small">Pagar al vendedor</button></form>
          <form action="/admin/pedidos/<%= o.id %>/reembolsar" method="post" data-confirm="¿Resolver a favor del comprador y devolverle el dinero?"><button class="btn btn-small btn-ghost">Reembolsar al comprador</button></form>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (queues.refunds.length) { %>
    <h3>3. Reembolsos por enviar <span class="badge"><%= queues.refunds.length %></span></h3>
    <p class="hint">Devuelve el monto por SINPE al número desde el que pagó el comprador (lo ves en tu banco con el comprobante) y márcalo aquí.</p>
    <div class="task-list">
      <% for (const o of queues.refunds) { %>
        <div class="task">
          <div class="task-main"><strong><%= o.code %></strong> · devolver <strong><%= money(o.total || o.price) %></strong> a <%= o.buyer_name %> · pagó <%= o.payer_name || o.payment_reference %></div>
          <form action="/admin/pedidos/<%= o.id %>/reembolsado" method="post" data-confirm="¿Ya devolviste <%= money(o.total || o.price) %>?"><button class="btn btn-small">Ya lo devolví</button></form>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (queues.payouts.length) { %>
    <h3>4. Pagos a vendedores <span class="badge"><%= queues.payouts.length %></span></h3>
    <p class="hint">Se pagan <%= payoutRule() %>. Transfiere por SINPE Móvil y marca cada pedido. Tu comisión ya está descontada del monto (y el envío, si lo hubo, ya está sumado).</p>
    <% const today = todayCR();
       const groupBy = (list) => Object.values(list.reduce((acc, o) => {
         const k = o.payout_phone || o.store_name;
         acc[k] = acc[k] || { store: o.payout_name || o.store_name, phone: o.payout_phone, total: 0, n: 0 };
         acc[k].total += o.payout_amount; acc[k].n += 1;
         return acc;
       }, {}));
       const dueNow = groupBy(queues.payouts.filter((o) => o.payout_day <= today));
       const upcoming = queues.payouts.filter((o) => o.payout_day > today); %>
    <% if (dueNow.length) { %>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Tienda</th><th>SINPE</th><th>Pedidos</th><th>Para pagar hoy</th></tr></thead>
          <tbody>
            <% for (const s of dueNow) { %><tr><td><%= s.store %></td><td><%= s.phone || '— sin SINPE —' %></td><td><%= s.n %></td><td><strong><%= money(s.total) %></strong></td></tr><% } %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="muted small">Hoy no hay pagos pendientes; abajo están los de los próximos días.</p>
    <% } %>
    <% if (upcoming.length) { %><p class="muted small">Próximos días: <%= upcoming.length %> pago<%= upcoming.length === 1 ? '' : 's' %> por <%= money(upcoming.reduce((a, o) => a + o.payout_amount, 0)) %> (se completaron de noche o en fin de semana).</p><% } %>
    <div class="task-list">
      <% for (const o of queues.payouts) { %>
        <div class="task">
          <div class="task-main">
            Enviar <strong><%= money(o.payout_amount) %></strong> a <strong><%= o.payout_phone || '— sin SINPE registrado —' %></strong> (<%= o.payout_name || o.store_name %>)
            <span class="status status-<%= o.payout_day <= today ? 'por_pagar' : 'pendiente' %>">Pagar <%= payoutWhen(o).replace(' al final del día', '') %></span>
            <div class="muted small"><%= o.code %> · venta <%= money(o.price) %> − comisión <%= money(o.commission_amount) %> · completado <%= when(o.completed_at, true) %></div>
          </div>
          <form action="/admin/pedidos/<%= o.id %>/pago-vendedor" method="post" data-confirm="¿Ya le transferiste <%= money(o.payout_amount) %> a <%= o.payout_name || o.store_name %>?"><button class="btn btn-small">Ya le pagué</button></form>
        </div>
      <% } %>
    </div>
  <% } %>
</section>

<section id="ventas">
  <h2>Últimos pedidos</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Pedido</th><th>Artículo</th><th>Vendedor → comprador</th><th>Precio</th><th>Comisión</th><th>Estado</th></tr></thead>
      <tbody>
        <% for (const o of orders) { %>
          <tr>
            <td><strong><%= o.code %></strong><div class="muted small"><%= when(o.created_at, true) %> · <%= o.source === 'oferta' ? 'oferta' : 'compra directa' %></div></td>
            <td><%= o.product_title %></td>
            <td><%= o.store_name %> → <%= o.buyer_name %></td>
            <td><%= money(o.price) %><% if (o.price !== o.list_price) { %><div class="muted small">publicado <%= money(o.list_price) %></div><% } %></td>
            <td><%= money(o.commission_amount) %></td>
            <td><span class="status status-<%= o.status %>"><%= ORDER_STATUS[o.status] %></span><% if (o.status === 'completado') { %><div class="muted small">vendedor <%= o.payout_status === 'pagado' ? 'pagado' : 'por pagar' %></div><% } %></td>
          </tr>
        <% } %>
        <% if (!orders.length) { %><tr><td colspan="6" class="muted">Sin pedidos todavía.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>

<section id="usuarios">
  <div class="section-head">
    <h2>Usuarios y tiendas</h2>
    <a class="btn btn-small" href="/admin/tiendas/nueva">+ Crear tienda</a>
  </div>
  <p class="hint">Para subir el inventario de una tienda de una sola vez (Excel o Google Sheets + fotos), toca <strong>"Cargar artículos"</strong> en su fila.</p>
  <p class="hint">Una tienda <strong>destacada</strong> sale primero en "Más recientes" y en la portada, con la marca "★ Destacada". Úsalo para tiendas de confianza o que te paguen por promoción.</p>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Usuario</th><th>Contacto</th><th>Recibe pagos en</th><th>Activos</th><th>Ventas</th><th>Problemas</th><th>Bloqueos</th><th>Prioridad</th><th></th></tr></thead>
      <tbody>
        <% for (const s of sellers) { %>
          <tr class="<%= s.active ? '' : 'row-off' %>">
            <td><strong><%= s.store_name %></strong><div class="muted small"><%= s.name %> · <%= s.province %></div>
              <% const st = { aprobado: ['vendido', 'Tienda aprobada'], pendiente: ['por_pagar', 'Por aprobar'], rechazado: ['en_disputa', 'No aprobada'] }[s.seller_status]; %>
              <% if (st) { %><span class="status status-<%= st[0] %>"><%= st[1] %></span><% } %></td>
            <td><%= s.phone %><div class="muted small"><%= s.email %></div></td>
            <td><%= s.payout_phone || '—' %><div class="muted small"><%= s.payout_name || '' %></div></td>
            <td><%= s.products %></td>
            <td><%= s.sales %></td>
            <td><% if (s.problems) { %><span class="status status-en_disputa"><%= s.problems %></span><% } else { %>0<% } %></td>
            <td><% if (s.flagged) { %><span class="status status-por_pagar"><%= s.flagged %></span><% } else { %>0<% } %></td>
            <td>
              <% if (s.featured) { %>
                <span class="featured-pill">★ Destacada</span>
                <div class="muted small"><%= s.featured_until > '2100' ? 'sin fecha de fin' : `hasta ${when(s.featured_until, true)}` %></div>
                <form action="/admin/tiendas/<%= s.id %>/destacar" method="post" class="inline">
                  <button class="btn btn-small btn-ghost" name="days" value="quitar">Quitar</button>
                </form>
              <% } else if (s.active) { %>
                <form action="/admin/tiendas/<%= s.id %>/destacar" method="post" class="feature-form">
                  <select name="days" aria-label="Por cuánto tiempo">
                    <option value="7">7 días</option>
                    <option value="30" selected>30 días</option>
                    <option value="90">90 días</option>
                    <option value="siempre">Sin fecha de fin</option>
                  </select>
                  <button class="btn btn-small btn-ghost">Destacar</button>
                </form>
              <% } %>
            </td>
            <td class="actions">
              <% if (s.active) { %><a class="btn btn-small" href="/admin/tiendas/<%= s.id %>/carga">Cargar artículos</a><% } %>
              <a class="btn btn-small btn-ghost" href="/admin/tiendas/<%= s.id %>/historial">Ventas y reseñas previas</a>
              <% if (s.seller_status === 'aprobado') { %>
                <form action="/admin/tiendas/<%= s.id %>/quitar-aprobacion" method="post" class="inline" data-confirm="¿Quitarle a <%= s.store_name %> el permiso de vender? Sus artículos a la venta quedan pausados.">
                  <button class="btn btn-small btn-ghost">Quitar aprobación</button>
                </form>
              <% } else if (s.seller_status === 'rechazado') { %>
                <form action="/admin/tiendas/<%= s.id %>/aprobar" method="post" class="inline"><button class="btn btn-small btn-ghost">Aprobar</button></form>
              <% } %>
              <form action="/admin/vendedores/<%= s.id %>/activo" method="post" class="inline">
                <input type="hidden" name="active" value="<%= s.active ? '0' : '1' %>">
                <button class="btn btn-small btn-ghost"><%= s.active ? 'Suspender' : 'Reactivar' %></button>
              </form>
              <% if (s.active) { %>
                <form action="/admin/vendedores/<%= s.id %>/enlace-contrasena" method="post" class="inline" data-confirm="¿Generar un enlace para que <%= s.store_name %> cambie su contraseña? Mándalo solo a <%= s.email %>.">
                  <button class="btn btn-small btn-ghost">Enlace contraseña</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
        <% if (!sellers.length) { %><tr><td colspan="9" class="muted">Sin usuarios todavía.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>

<section id="config" class="admin-split">
  <div>
    <h2>Cobro</h2>
    <p class="hint">Los compradores te pagan por SINPE Móvil a esta cuenta (BAC, Wink u otra). Se muestra solo en pedidos por pagar.</p>
    <form action="/admin/pagos-config" method="post" class="stack">
      <div class="row2">
        <label>Número SINPE Móvil<input name="phone" required inputmode="tel" value="<%= pay.phone %>" placeholder="8888-8888"></label>
        <label>Titular de la cuenta<input name="holder" required maxlength="80" value="<%= pay.holder %>"></label>
      </div>
      <div class="row2">
        <label>Horas para pagar<input type="number" name="window_hours" min="1" max="168" value="<%= pay.windowHours %>"></label>
        <label>Días para liberar el pago<input type="number" name="release_days" min="1" max="30" value="<%= pay.releaseDays %>"></label>
      </div>
      <div class="row2">
        <label>Hora de corte de pagos a tiendas
          <select name="cutoff_hour">
            <% for (let h = 12; h <= 23; h++) { %><option value="<%= h %>" <%= pay.cutoffHour === h ? 'selected' : '' %>><%= h % 12 === 0 ? 12 : h % 12 %> p. m.</option><% } %>
          </select>
          <span class="hint">Ventas completadas después de esta hora (o en fin de semana) se pagan el siguiente día hábil.</span>
        </label>
        <label>Tarifa de Mensajería CowFace (GAM, ₡)<input name="courier_fee" inputmode="numeric" value="<%= pay.courierFee %>">
          <span class="hint">Lo que paga el comprador por el envío con nuestro mensajero dentro del GAM. Ese monto es de CowFace, no de la tienda.</span>
        </label>
      </div>
      <button class="btn">Guardar cobro</button>
    </form>
    <form action="/admin/mensajeria" method="post" class="stack approval-form">
      <label class="check">
        <input type="checkbox" name="on" value="1" <%= courierOn() ? 'checked' : '' %> data-autosubmit>
        <span><strong>Ofrecer la Mensajería CowFace dentro del GAM.</strong> Apagada, el GAM se envía por Correos como el resto del país (y no se muestra en la página).</span>
      </label>
      <noscript><button class="btn btn-small">Guardar</button></noscript>
    </form>
    <form action="/admin/soporte-tiendas" method="post" class="stack">
      <label>WhatsApp de soporte para tiendas
        <input name="phone" inputmode="tel" value="<%= support ? support.phone : '' %>" placeholder="8888-8888">
        <span class="hint">Solo lo ven las tiendas (en su panel y en el chat con CowFace), aparte del chat. Vacío: no se muestra.</span>
      </label>
      <button class="btn btn-small btn-ghost">Guardar número</button>
    </form>
    <form action="/admin/aprobacion" method="post" class="stack approval-form">
      <label class="check">
        <input type="checkbox" name="on" value="1" <%= approvalOn ? 'checked' : '' %> data-autosubmit>
        <span><strong>Aprobar tiendas antes de que publiquen.</strong> Quien quiera vender te manda una solicitud; comprar no necesita aprobación.</span>
      </label>
      <noscript><button class="btn btn-small">Guardar</button></noscript>
    </form>
    <form action="/admin/comision" method="post" class="rate-form commission-form">
      <label>Comisión por venta
        <input type="number" name="percent" min="0" max="50" step="0.5" value="<%= +(rate * 100).toFixed(2) %>">%
      </label>
      <button class="btn btn-small">Guardar</button>
    </form>
    <p class="hint">La comisión queda fija en cada pedido al crearse. Cambiarla no altera pedidos anteriores.</p>
  </div>
  <div id="filtro">
    <h2>Palabras prohibidas en el chat</h2>
    <p class="hint">Una por línea. Se bloquean aunque las escriban con espacios, tildes o números. Teléfonos, correos y enlaces se bloquean siempre.</p>
    <form action="/admin/palabras" method="post" class="stack">
      <textarea name="words" rows="10"><%= words.join('\n') %></textarea>
      <button class="btn">Guardar lista</button>
    </form>
  </div>
</section>

<section id="cifrado">
  <h2>Cifrado de los chats</h2>
  <% if (chatEncrypted) { %>
    <p class="hint">✓ Los mensajes, fotos y comprobantes del chat se guardan cifrados (AES-256): en la base de datos y en los respaldos son ilegibles sin la clave <code>CHAT_KEY</code>. <strong>Nunca la cambies ni la borres</strong>: lo cifrado con ella no se podría volver a leer.</p>
  <% } else { %>
    <div class="notice">
      <strong>Los chats todavía se guardan sin cifrar.</strong> Para cifrarlos: en Railway → tu servicio → <strong>Variables</strong>, agrega <code>CHAT_KEY</code> con una contraseña larga (16+ caracteres, distinta de BACKUP_PASSWORD).
      Al reiniciarse, se cifran también todos los mensajes y archivos anteriores. Guárdala junto a BACKUP_PASSWORD: si se pierde, los chats cifrados no se pueden leer. No la compartas con nadie.
    </div>
  <% } %>
</section>

<section id="espacio">
  <h2>Espacio</h2>
  <% if (!disk) { %>
    <p class="muted">Calculando cuánto espacio se usa… recarga en un momento.</p>
  <% } else { %>
    <% const level = disk.percent == null ? '' : disk.percent >= 90 ? 'is-danger' : disk.percent >= 80 ? 'is-warn' : ''; %>
    <% if (disk.percent != null) { %>
      <p><strong><%= formatBytes(disk.used) %></strong> usados de <strong><%= formatBytes(disk.total) %></strong> (<%= disk.percent %> %). Quedan <strong><%= formatBytes(disk.free) %></strong><% if (disk.productsLeft != null) { %>, para unos <strong><%= disk.productsLeft.toLocaleString('es-CR') %> artículos</strong> más<% } %>.</p>
      <div class="disk-bar <%= level %>"><span data-width="<%= disk.percent %>"></span></div>
      <% if (disk.percent >= 80) { %><div class="notice"><strong>El volumen se está llenando.</strong> Agrándalo en Railway → cowface-volume → Settings → Volume Size, y luego pon el tamaño nuevo aquí abajo. Si se llena, las tiendas no van a poder subir fotos.</div><% } %>
    <% } %>
    <div class="table-wrap">
      <table>
        <tbody>
          <tr><td>Fotos de artículos</td><td><%= formatBytes(disk.parts.photos) %></td><td class="muted small"><%= disk.photoFiles.toLocaleString('es-CR') %> archivos · <%= disk.products.toLocaleString('es-CR') %> artículos<% if (disk.perProduct) { %> · unos <%= formatBytes(disk.perProduct) %> por artículo<% } %></td></tr>
          <tr><td>Comprobantes y adjuntos del chat</td><td><%= formatBytes(disk.parts.attachments) %></td><td></td></tr>
          <tr><td>Base de datos</td><td><%= formatBytes(disk.parts.database) %></td><td></td></tr>
          <tr><td>Respaldos (últimos 7)</td><td><%= formatBytes(disk.parts.backups) %></td><td></td></tr>
        </tbody>
      </table>
    </div>
    <p class="hint">Se actualiza cada 10 minutos. Te llega un correo cuando pase del 80 %, 90 % y 95 %.</p>
  <% } %>
  <form action="/admin/espacio" method="post" class="inline-form">
    <label>Tamaño del volumen en Railway (GB) <input name="volume_gb" type="number" min="0" max="10000" step="0.1" value="<%= volumeGb || '' %>" placeholder="5"></label>
    <button class="btn btn-small btn-ghost">Guardar</button>
  </form>
  <p class="hint">Ponlo igual al "Volume Size" de Railway para que el porcentaje sea exacto. Vacío: se usa lo que reporta el disco.</p>
</section>

<section id="respaldos">
  <h2>Respaldos</h2>
  <% const b = backups; const kb = (n) => n > 1048576 ? `${(n / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(n / 1024))} KB`; %>
  <p>
    <% if (b.lastAt) { %>Último respaldo: <strong><%= when(b.lastAt, true) %></strong>.<% } else { %><strong>Todavía no hay respaldos.</strong> El primero se hace solo en unos minutos, o tócalo abajo.<% } %>
    Se hace uno solo todos los días y se guardan los últimos 7 aquí.
  </p>
  <% if (!b.encryption) { %>
    <div class="notice">
      <strong>Falta un paso para que te lleguen por correo</strong> (una copia fuera de Railway, por si el servidor se pierde):
      en Railway → tu servicio → <strong>Variables</strong>, agrega <code>BACKUP_PASSWORD</code> con una contraseña larga (12+ caracteres) que solo tú sepas
      y guárdala en un lugar seguro (sin ella no se pueden abrir los respaldos). No la compartas con nadie.
    </div>
  <% } else if (!b.mail) { %>
    <div class="notice">Los respaldos no se pueden mandar por correo porque el envío de correos (Brevo) no está configurado.</div>
  <% } else { %>
    <p class="hint">✓ Cada día te llega por correo a <strong><%= notify.email %></strong> una copia cifrada de la base de datos<%= b.lastEmail === 'enviado' ? ' (la última se envió bien)' : b.lastEmail === 'muy-grande' ? ' (la última era muy grande para el correo: descárgala aquí)' : b.lastEmail === 'error' ? ' (la última falló: revisa Brevo)' : '' %>.</p>
  <% } %>
  <div class="push-actions">
    <form action="/admin/respaldos/ahora" method="post" class="inline"><button class="btn btn-small">Hacer un respaldo ahora</button></form>
    <a class="btn btn-small btn-ghost" href="/admin/respaldos/completo">Descargar todo (base + fotos + adjuntos)</a>
  </div>
  <p class="hint">"Descargar todo" baja un archivo .tar.gz con todo lo necesario para levantar CowFace de nuevo. Hazlo una vez al mes y guárdalo en tu computadora o Google Drive.</p>
  <% if (b.files.length) { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Día</th><th>Tamaño</th><th></th></tr></thead>
        <tbody>
          <% for (const f of b.files) { %>
            <tr><td><%= f.day %></td><td><%= kb(f.size) %></td><td><a class="file-link" href="/admin/respaldos/<%= f.name %>">Descargar base</a></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section id="notificaciones">
  <h2>Notificaciones</h2>
  <% if (!mailReady) { %>
    <div class="notice">El envío de correos no está configurado (Brevo), así que no te llegarán avisos.</div>
  <% } %>
  <p class="hint">Te mandamos un correo cuando pasa algo de esto. Además, el botón <strong>Admin</strong> de arriba muestra cuántas tareas tienes pendientes.</p>
  <form action="/admin/notificaciones" method="post" class="stack notify-form">
    <label>Correo para los avisos
      <input type="email" name="email" value="<%= notify.customEmail %>" placeholder="<%= notify.email || 'tu correo' %>" maxlength="120">
      <span class="hint">Vacío = el correo de tu cuenta de admin<%= notify.email && !notify.customEmail ? ` (${notify.email})` : '' %>.</span>
    </label>
    <fieldset class="notify-events">
      <legend>Avisarme cuando…</legend>
      <% for (const [k, e] of Object.entries(NOTIFY_EVENTS)) { %>
        <label class="check"><input type="checkbox" name="events" value="<%= k %>" <%= notify.events.has(k) ? 'checked' : '' %>> <%= e.label %></label>
      <% } %>
    </fieldset>
    <button class="btn">Guardar notificaciones</button>
  </form>
</section>

<section id="bloqueados">
  <h2>Intentos bloqueados</h2>
  <% if (!flagged.length) { %>
    <p class="muted">Nadie ha intentado compartir contacto todavía.</p>
  <% } else { %>
    <div class="flag-list">
      <% for (const f of flagged) { %>
        <div class="flag">
          <div class="flag-head"><strong><%= f.name %></strong> <span class="muted small"><%= f.email %> · <%= f.context %> · <%= when(f.created_at, true) %></span></div>
          <div class="flag-body">"<%= f.body %>"</div>
          <span class="status status-por_pagar">detectó: <%= f.matched %></span>
        </div>
      <% } %>
    </div>
  <% } %>
</section>
</div>
</div>
<%- include('../partials/footer') %>
