<%- include('../partials/header') %>
<% const err = (k) => errors[k] ? `<span class="error">${errors[k]}</span>` : ''; %>
<section class="auth auth-wide">
  <p class="muted small"><a href="/admin#usuarios">← Administración</a></p>
  <h1>Historial de <%= store.store_name %></h1>
  <p class="muted">Ventas y reseñas que la tienda ya tenía antes de <%= siteName %> (por ejemplo, en Instagram). Se suman a las que haga aquí, que se van agregando solas.</p>
  <div class="pay-card single">
    <span>En <%= siteName %> hasta hoy: <strong><%= store.platform_sales %></strong> venta<%= store.platform_sales === 1 ? '' : 's' %> y <strong><%= store.platform_reviews %></strong> reseña<%= store.platform_reviews === 1 ? '' : 's' %>.</span>
  </div>
  <form action="/admin/tiendas/<%= store.id %>/historial" method="post" class="stack">
    <label>Ventas previas
      <input name="sales_base" inputmode="numeric" value="<%= form.sales_base || '' %>" placeholder="0">
      <%- err('sales_base') %>
    </label>
    <div class="row2">
      <label>Reseñas previas (cantidad)
        <input name="reviews_base_count" inputmode="numeric" value="<%= form.reviews_base_count || '' %>" placeholder="0">
        <%- err('reviews_base_count') %>
      </label>
      <label>Promedio de esas reseñas
        <input name="reviews_base_avg" inputmode="decimal" value="<%= form.reviews_base_count ? form.reviews_base_avg : '' %>" placeholder="Ej. 4.9">
        <%- err('reviews_base_avg') %>
      </label>
    </div>
    <label>¿De dónde vienen?
      <input name="history_source" maxlength="40" value="<%= form.history_source || '' %>" placeholder="Ej. Instagram">
      <span class="hint">Se muestra en el perfil: "Incluye historial de antes de CowFace (Instagram): 120 ventas y 85 reseñas (★ 4.9)".</span>
      <%- err('history_source') %>
    </label>
    <p class="hint"><strong>Pon solo números reales que puedas respaldar</strong> (capturas de las reseñas, registro de ventas). Mostrar ventas o reseñas inventadas engaña a los compradores y puede traerte problemas legales.</p>
    <button class="btn">Guardar historial</button>
  </form>
</section>
<%- include('../partials/footer') %>
