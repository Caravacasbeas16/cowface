<%# Estado de una persona o tienda: en línea / activa hace…, y si es tienda con horario, abierta o cerrada. Variables: presence, hoursStatus (opcional). %>
<span class="presence <%= presence.online ? 'presence-on' : '' %>"><span class="presence-dot" aria-hidden="true"></span><%= presence.label %></span>
<% if (locals.hoursStatus && hoursStatus.has) { %><span class="hours-pill <%= hoursStatus.open ? 'hours-open' : '' %>"><%= hoursStatus.label %></span><% } %>
