<%# Menú del panel de la tienda. Variables: active, toAttend, paused, storeOpen, sellerState. %>
<% const items = [
  ['inicio', '/vendedor', 'Inicio', 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z'],
  ['pedidos', '/vendedor/pedidos', 'Pedidos', 'M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6'],
  ['inventario', '/vendedor/inventario', 'Inventario', 'M4 7l8-4 8 4v10l-8 4-8-4zM4 7l8 4 8-4M12 11v10'],
  ['promos', '/vendedor/promos', 'Promos', 'M20 12l-8 8-9-9V3h8zM7.5 7.5h.01'],
  ['ganancias', '/vendedor/ganancias', 'Ganancias', 'M4 19V9M10 19V5M16 19v-7M22 19H2'],
  ['resenas', '/vendedor/resenas', 'Reseñas', 'M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z'],
  ['mensajes', '/mensajes', 'Mensajes', 'M4 5h16v11H8l-4 4z'],
  ['configuracion', '/vendedor/configuracion', 'Configuración', 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19 12l2-1-1-3-2 .3-1.3-1.3L17 5l-3-1-1 2h-2L10 4 7 5l.3 2L6 8.3 4 8l-1 3 2 1v0l-2 1 1 3 2-.3L7.3 17 7 19l3 1 1-2h2l1 2 3-1-.3-2 1.3-1.3 2 .3 1-3z'],
]; %>
<aside class="portal-nav" aria-label="Panel de la tienda">
  <div class="portal-store">
    <span class="avatar"><%= (user.store_name || user.name).charAt(0).toUpperCase() %></span>
    <div class="portal-store-name">
      <strong><%= user.store_name || user.name %></strong>
      <% if (paused) { %>
        <span class="store-state store-paused">● En pausa</span>
      <% } else if (sellerState === 'pendiente') { %>
        <span class="store-state store-paused">● En revisión</span>
      <% } else if (storeOpen.has) { %>
        <span class="store-state <%= storeOpen.open ? 'store-open' : '' %>">● <%= storeOpen.open ? 'Abierta' : 'Cerrada' %></span>
      <% } else { %>
        <span class="store-state store-open">● Recibiendo pedidos</span>
      <% } %>
    </div>
  </div>
  <nav class="portal-links">
    <% for (const [key, href, label, d] of items) { %>
      <a href="<%= href %>" class="<%= active === key ? 'is-active' : '' %>" <%- active === key ? 'aria-current="page"' : '' %>>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="<%= d %>" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
        <span><%= label %></span>
        <% if (key === 'pedidos' && toAttend) { %><span class="badge"><%= toAttend %></span><% } %>
        <% if (key === 'mensajes' && unread) { %><span class="badge"><%= unread %></span><% } %>
      </a>
    <% } %>
    <span class="portal-sep" aria-hidden="true"></span>
    <a href="/vendedor/compras" class="<%= active === 'compras' ? 'is-active' : '' %>">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M5 8h14l-1 12H6zM9 8V6a3 3 0 0 1 6 0v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
      <span>Mis compras</span>
    </a>
    <a href="/u/<%= user.id %>">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
      <span>Ver mi tienda</span>
    </a>
  </nav>
  <a class="btn btn-block portal-add" href="/vendedor/productos/nuevo">+ Agregar artículo</a>
</aside>
