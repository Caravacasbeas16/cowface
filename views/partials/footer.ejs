</main>
<% if (locals.tabbar) { %>
  <% const at = (...pre) => (pre.some((x) => (x === '/' ? path === '/' : (path || '').startsWith(x))) ? 'is-active' : ''); %>
  <nav class="tabbar" aria-label="Navegación principal">
    <a href="/" class="<%= at('/') %>"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg><span>Inicio</span></a>
    <a href="/buscar" class="<%= at('/buscar', '/tiendas', '/u/') %>"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg><span>Buscar</span></a>
    <% if (user) { %>
      <a href="/favoritos" class="<%= at('/favoritos', '/siguiendo') %>"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg><span>Favoritos</span></a>
      <a href="/mensajes" class="<%= at('/mensajes') %>"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5h16v11H8l-4 4z"/></svg><span>Mensajes</span><span class="badge" data-unread <%= unread ? '' : 'hidden' %>><%= unread %></span></a>
      <a href="/vendedor" class="<%= at('/vendedor') %>"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"/></svg><span>Mi cuenta</span></a>
    <% } else { %>
      <a href="/vender" class="<%= at('/vender') %>"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg><span>Vender</span></a>
      <a href="/entrar" class="<%= at('/entrar', '/registro') %>"><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c1-4 4.5-6 8-6s7 2 8 6"/></svg><span>Entrar</span></a>
    <% } %>
  </nav>
<% } %>
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <div class="logo"><img src="/img/logo.jpg" alt="" width="40" height="40"><span><%= siteName.toUpperCase() %></span></div>
      <p class="muted">Vintage y segunda mano. Prendas curadas, no fast fashion. Pago protegido y envíos a todo Costa Rica.</p>
      <a class="footer-ig" href="https://www.instagram.com/cowface.cr/" target="_blank" rel="noopener">@cowface.cr en Instagram</a>
    </div>
    <div class="footer-col">
      <h4>Comprar</h4>
      <a href="/buscar">Explorar todo</a>
      <a href="/tiendas">Tiendas</a>
      <a href="/buscar?para=hombre">Hombre</a>
      <a href="/buscar?para=mujer">Mujer</a>
      <a href="/buscar?categoria=zapatos">Zapatos</a>
    </div>
    <div class="footer-col">
      <h4>Vender</h4>
      <a href="/vender">Publicar un artículo</a>
      <a href="/como-funciona">Cómo funciona la compra protegida</a>
      <a href="/instalar">Instalar la app</a>
    </div>
    <div class="footer-col">
      <h4>Ayuda</h4>
      <a href="/terminos">Términos</a>
      <a href="/privacidad">Privacidad</a>
      <a href="/borrar-cuenta">Borrar tu cuenta</a>
      <% if (contactEmail) { %><a href="mailto:<%= contactEmail %>">Contacto</a><% } %>
    </div>
  </div>
  <div class="wrap footer-bottom muted small">© <%= new Date().getFullYear() %> <%= siteName %></div>
</footer>
<% if (['/', '/mensajes', '/vendedor', '/buscar'].includes(path)) { %>
  <div class="install-banner" data-install-banner hidden>
    <img src="/img/icon-192.png" alt="" width="40" height="40">
    <div class="install-text"><strong>Instala CowFace</strong><span>Como una app, con avisos en tu celular.</span></div>
    <button class="btn btn-small" type="button" data-install>Instalar</button>
    <button class="install-close" type="button" data-install-dismiss aria-label="Cerrar">×</button>
  </div>
<% } %>
<script id="catalog-data" type="application/json"><%- JSON.stringify(
  Object.fromEntries(Object.entries(catalog.CATEGORIES).map(([k, c]) => [k, { types: c.types, sizes: c.sizes }]))
).replace(/</g, '\\u003c') %></script>
<script src="/js/app.js?v=<%= assetVersion %>" defer></script>
<script src="/js/push.js?v=<%= assetVersion %>" defer></script>
<script src="/js/install.js?v=<%= assetVersion %>" defer></script>
<script src="/js/chat.js?v=<%= assetVersion %>" defer></script>
<% if (locals.portal) { %><script src="/js/portal.js?v=<%= assetVersion %>" defer></script><% } %>
</body>
</html>
