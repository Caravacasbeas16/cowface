<%# Menú del panel del admin. Variables: adminActive, adminNav (contadores de lo pendiente). %>
<% const n = locals.adminNav || {}; const active = locals.adminActive || 'inicio';
   const items = [
     ['inicio', '/admin', 'Inicio', 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z', null],
     ['pagos', '/admin/pagos', 'Pagos', 'M3 7h18v10H3zM3 11h18M7 15h3', n.pagos],
     ['tiendas', '/admin/tiendas', 'Tiendas', 'M4 9l1-5h14l1 5M4 9v11h16V9M4 9h16M9 20v-6h6v6', n.tiendas],
     ['pedidos', '/admin/pedidos', 'Pedidos', 'M6 3h12v18l-3-2-3 2-3-2-3 2zM9 8h6M9 12h6', n.pedidos],
     ...(courierOn() || n.rutas ? [['rutas', '/admin/rutas', 'Rutas', 'M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM19 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4zM5 15V9a4 4 0 0 1 4-4h6M19 9v6a4 4 0 0 1-4 4H9', n.rutas]] : []),
     ['fotos', '/admin/fotos', 'Fotos', 'M4 7h4l2-3h4l2 3h4v13H4zM12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8z', n.fotos],
     ['mensajes', '/admin/mensajes', 'Mensajes', 'M4 5h16v11H8l-4 4z', n.mensajes],
     ['ganancias', '/admin/ganancias', 'Ganancias', 'M4 19V9M10 19V5M16 19v-7M22 19H2', null],
     ['soporte', '/admin#reportes', 'Reportes y ayuda', 'M12 3l9 16H3zM12 10v4M12 17h.01', n.soporte],
     ['config', '/admin#config', 'Configuración', 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19 12l2-1-1-3-2 .3-1.3-1.3L17 5l-3-1-1 2h-2L10 4 7 5l.3 2L6 8.3 4 8l-1 3 2 1-2 1 1 3 2-.3L7.3 17 7 19l3 1 1-2h2l1 2 3-1-.3-2 1.3-1.3 2 .3 1-3z', null],
   ]; %>
<aside class="portal-nav" aria-label="Panel del admin">
  <div class="portal-store">
    <span class="avatar store-logo store-logo-sm">A</span>
    <div class="portal-store-name"><strong>Administración</strong><span class="store-state store-open">● <%= siteName %></span></div>
  </div>
  <nav class="portal-links">
    <% for (const [key, href, label, d, badge] of items) { %>
      <a href="<%= href %>" class="<%= active === key ? 'is-active' : '' %>" <%- active === key ? 'aria-current="page"' : '' %>>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="<%= d %>" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg>
        <span><%= label %></span>
        <% if (badge) { %><span class="badge"><%= badge %></span><% } %>
      </a>
    <% } %>
    <span class="portal-sep" aria-hidden="true"></span>
    <a href="/tiendas"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M14 4h6v6M20 4l-9 9M18 14v6H4V6h6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round"/></svg><span>Ver el sitio</span></a>
  </nav>
  <a class="btn btn-block portal-add" href="/admin/tiendas/nueva">+ Crear tienda</a>
</aside>
