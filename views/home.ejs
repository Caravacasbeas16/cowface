<%- include('partials/header') %>
<%
  const heroPhoto = brandPhotos[0];
  const strip = brandPhotos.slice(1, 6);
  // Portada de cada categoría: foto real de un artículo; si no hay, foto de marca (solo ropa) o recuadro negro con el logo.
  const fallback = { ropa: brandPhotos.find((p) => p.includes('camisetas')) };
  const cover = (key) => covers[key] ? imageUrl({ id: covers[key].id, category: key, image: covers[key].image }) : fallback[key] || null;
%>
<section class="hero">
  <div class="hero-text">
    <p class="eyebrow">Vintage · Segunda mano · Costa Rica</p>
    <h1>Prendas con historia.<br>Precio entre personas.</h1>
    <p class="hero-sub">Compra y vende ropa, zapatos y bolsos curados. Haz tu oferta, chatea con el vendedor y paga protegido: el dinero llega al vendedor solo cuando recibes tu prenda.</p>
    <div class="hero-actions">
      <a class="btn" href="/buscar">Explorar</a>
      <a class="btn btn-ghost" href="/vender">Vender</a>
    </div>
  </div>
  <% if (heroPhoto) { %>
    <a class="hero-photo" href="/buscar"><img src="<%= heroPhoto %>" alt="Drop de prendas vintage de CowFace"></a>
  <% } %>
</section>

<% if (strip.length) { %>
  <section class="strip" aria-label="Drops de la comunidad">
    <% for (const src of strip) { %>
      <a href="/buscar"><img src="<%= src %>" alt="" loading="lazy"></a>
    <% } %>
  </section>
<% } %>

<section>
  <div class="section-head"><h2>Comprar por categoría</h2></div>
  <div class="cat-grid">
    <% for (const [key, c] of Object.entries(catalog.CATEGORIES)) { %>
      <% const src = cover(key); %>
      <a class="cat-tile <%= src ? '' : 'cat-tile-empty' %>" href="/buscar?categoria=<%= key %>">
        <img src="<%= src || '/img/logo.jpg' %>" alt="" loading="lazy">
        <span class="cat-label"><%= c.label %><small><%= counts[key] || 0 %> artículos</small></span>
      </a>
    <% } %>
  </div>
</section>

<section data-recent-section hidden>
  <div class="section-head"><h2>Vistos recientemente</h2><button type="button" class="linklike small" data-recent-clear>Borrar</button></div>
  <div class="recent-row" data-recent-list></div>
</section>

<section>
  <div class="section-head">
    <h2>Recién publicados</h2>
    <a href="/buscar" class="link-arrow">Ver todo</a>
  </div>
  <% if (latest.length) { %>
    <div class="grid">
      <% for (const p of latest) { %><%- include('partials/card', { p }) %><% } %>
    </div>
  <% } else { %>
    <div class="empty">
      <h3>El primer drop está por llegar</h3>
      <p class="muted">Todavía no hay artículos publicados.</p>
      <a class="btn" href="/vender">Publica el primero</a>
    </div>
  <% } %>
</section>

<section class="values">
  <div><h3>Pago protegido</h3><p>Pagas a CowFace por SINPE. El vendedor recibe el dinero cuando confirmas que te llegó. <a href="/como-funciona">Cómo funciona</a></p></div>
  <div><h3>Haz tu oferta</h3><p>Paga el precio publicado o negocia. El vendedor acepta, rechaza o contraoferta.</p></div>
  <div><h3>Chat seguro</h3><p>Todo el trato queda en CowFace. Si algo sale mal, abres un reclamo.</p></div>
  <div><h3>Envíos a todo CR</h3><p>Correos de Costa Rica a todo el país, nuestra Mensajería CowFace dentro del GAM o pick up. Ves el total antes de pagar.</p></div>
</section>

<section class="cta">
  <img src="/img/logo.jpg" alt="" width="72" height="72">
  <div>
    <h2>¿Tienes ropa que ya no usas?</h2>
    <p>Publica gratis y cobra seguro por SINPE cuando vendes.</p>
  </div>
  <a class="btn btn-light" href="/vender">Empieza a vender</a>
</section>
<%- include('partials/footer') %>
