<%- include('partials/header') %>
<%
  const p = product;
  const measureList = (catalog.MEASUREMENTS[p.category] || []).filter((m) => p.measurements && p.measurements[m.key]);
%>
<nav class="crumbs">
  <a href="/buscar" class="back-to-results" data-back-results hidden>← Volver a los resultados</a>
  <a href="/buscar?categoria=<%= p.category %>"><%= catalog.CATEGORIES[p.category]?.label %></a> ›
  <a href="/buscar?categoria=<%= p.category %>&tipo=<%= encodeURIComponent(p.item_type) %>"><%= p.item_type %></a>
</nav>
<% if (justPublished) { %>
  <div class="notice notice-ok">¡Publicado! Así ven tu artículo los compradores. <a href="/vendedor/productos/nuevo">Publicar otro</a></div>
<% } %>
<div class="product">
  <div class="gallery" data-gallery>
    <% if (p.images.length) { %>
      <button type="button" class="gallery-main-btn" data-zoom-open aria-label="Ver foto en tamaño completo">
        <img class="gallery-main" src="/fotos/<%= p.images[0].filename %>" alt="<%= p.title %>" data-gallery-main data-index="0" data-full="/fotos/<%= p.images[0].original %>">
        <span class="zoom-hint" aria-hidden="true">⤢ Ver en tamaño real</span>
      </button>
      <% if (p.images.length > 1) { %>
        <div class="thumbs">
          <% p.images.forEach((img, i) => { %>
            <button type="button" class="thumb <%= i === 0 ? 'active' : '' %>" data-src="/fotos/<%= img.filename %>" data-full="/fotos/<%= img.original %>" data-index="<%= i %>" aria-label="Foto <%= i + 1 %>">
              <img src="/fotos/<%= img.thumb %>" alt="" loading="lazy">
            </button>
          <% }) %>
        </div>
      <% } %>
      <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Fotos de <%= p.title %>">
        <img alt="" data-lightbox-img>
        <button type="button" class="lb-close" data-lb-close aria-label="Cerrar">×</button>
        <% if (p.images.length > 1) { %>
          <button type="button" class="lb-nav lb-prev" data-lb-prev aria-label="Foto anterior">‹</button>
          <button type="button" class="lb-nav lb-next" data-lb-next aria-label="Foto siguiente">›</button>
          <span class="lb-count" data-lb-count></span>
        <% } %>
      </div>
    <% } else { %>
      <img class="gallery-main" src="<%= imageUrl(p, null) %>" alt="Sin foto">
    <% } %>
  </div>

  <div class="product-info">
    <% if (p.brand) { %><a class="product-brand" href="/buscar?q=<%= encodeURIComponent(p.brand) %>"><%= p.brand %></a><% } %>
    <h1><%= p.title %></h1>
    <div class="product-facts">
      <span>Talla <strong><%= p.size %></strong></span>
      <span><%= catalog.CONDITIONS[p.condition] %></span>
      <% if (p.color) { %><span><%= p.color %></span><% } %>
    </div>
    <% const off = p.compare_at_price > p.price ? Math.round((1 - p.price / p.compare_at_price) * 100) : 0; %>
    <div class="price"><%= money(p.price) %><% if (off) { %> <s class="was"><%= money(p.compare_at_price) %></s> <span class="sale-pill">−<%= off %> %</span><% } %></div>
    <% if (off) { %><div class="sale-note">🔥 <%= p.promo_store ? 'Promo de la tienda' : 'En oferta' %><%= p.promo_until ? ` ${untilLabel(p.promo_until)}` : '' %></div><% } %>
    <div class="ship-line">
      <span>🚚 Correos de Costa Rica o Uber Flash</span>
      <% if (p.meetup) { %><span>📍 Pick up<%= pickupPoints.length ? `: ${pickupPoints.join(' · ')}` : ` en ${p.province}` %></span><% } %>
    </div>
    <div class="muted small">Publicado <%= timeAgo(p.created_at) %> · <%= p.province %></div>

    <% if (isOwner) { %>
      <div class="notice">Este artículo es tuyo<%= p.status === 'borrador' ? ' y todavía es un borrador (nadie más lo ve)' : '' %>. <a href="/vendedor/productos/<%= p.id %>/editar">Editarlo</a></div>
      <% if (p.status === 'disponible' || p.status === 'pausado') { %>
        <form action="/vendedor/productos/<%= p.id %>/vendida" method="post" data-confirm="¿La vendiste? Se quita de la venta y las ofertas pendientes quedan sin efecto.">
          <input type="hidden" name="back" value="producto">
          <button class="btn btn-block">✓ Marcar como vendida</button>
          <p class="hint">¿La vendiste por otro lado? Márcala enseguida para que nadie la compre aquí.</p>
        </form>
      <% } %>
    <% } else if (blocked) { %>
      <div class="notice">No puedes comprar ni escribirle a este vendedor porque una de las dos cuentas bloqueó a la otra.</div>
    <% } else if (p.store_paused && p.status === 'disponible') { %>
      <div class="notice"><strong>⏸ Tienda en pausa:</strong> «<%= p.store_paused %>». Por ahora no se puede comprar ni ofertar; puedes escribirle a la tienda.</div>
      <% if (conversationId) { %><a class="btn btn-ghost btn-block" href="/mensajes/<%= conversationId %>">Ver mi conversación</a>
      <% } else if (user && user.role === 'usuario') { %>
        <form action="/p/<%= p.id %>/mensaje" method="post" class="ask-form">
          <label>Pregúntale a la tienda
            <textarea name="body" rows="2" maxlength="1000" required placeholder="¿Cuándo vuelven?"></textarea>
          </label>
          <button class="btn btn-ghost btn-block" type="submit">Enviar mensaje</button>
        </form>
      <% } %>
    <% } else if (p.status !== 'disponible') { %>
      <div class="notice">Este artículo ya no está disponible.</div>
      <% if (conversationId) { %><a class="btn btn-ghost btn-block" href="/mensajes/<%= conversationId %>">Ver mi conversación</a><% } %>
    <% } else if (!user) { %>
      <div class="deal-box">
        <a class="btn btn-block" href="/entrar?next=/p/<%= p.id %>">Comprar ahora · <%= money(p.price) %></a>
        <a class="btn btn-ghost btn-block" href="/entrar?next=/p/<%= p.id %>">Hacer oferta</a>
        <p class="hint center">Entra o <a href="/registro?next=/p/<%= p.id %>">crea tu cuenta</a> para comprar, ofertar o escribirle al vendedor.</p>
      </div>
    <% } else if (user.role === 'usuario') { %>
      <div class="deal-box">
        <div class="price-breakdown">
          <div><span>Prenda</span><span><%= money(p.price) %></span></div>
          <div><span>Entrega</span><span>Correos, Uber Flash<%= p.meetup ? ' o pick up' : '' %></span></div>
          <p class="hint guarantee">🛡️ <strong>Garantía CowFace:</strong> si hay un problema con tu compra, nos hacemos cargo.</p>
          <p class="hint">Después de comprar eliges cómo recibirlo y la tienda te cotiza el envío (como un Uber). Ves el total exacto antes de pagar<%= p.meetup ? '; el pick up no tiene costo' : '' %>.</p>
        </div>
        <form action="/p/<%= p.id %>/comprar" method="post" data-confirm="¿Comprar «<%= p.title %>» por <%= money(p.price) %>? Luego eliges la entrega, la tienda te cotiza el envío y le pagas a CowFace por SINPE Móvil. Guardamos el dinero hasta que recibas el artículo.">
          <button class="btn btn-block" type="submit">Comprar ahora</button>
        </form>
        <details class="offer-panel">
          <summary class="btn btn-ghost btn-block">Hacer oferta</summary>
          <form action="/p/<%= p.id %>/ofertar" method="post" class="offer-form">
            <label>Tu oferta por la prenda (₡)
              <input name="amount" required inputmode="numeric" placeholder="<%= minOffer %>" autocomplete="off">
            </label>
            <p class="hint">Mínimo <%= money(minOffer) %>, sin contar el envío. El vendedor puede aceptar, rechazar o contraofertar; la oferta vence en 48 horas.</p>
            <button class="btn btn-block" type="submit">Enviar oferta</button>
          </form>
        </details>
        <% if (conversationId) { %>
          <a class="btn btn-ghost btn-block" href="/mensajes/<%= conversationId %>">Ver mi conversación</a>
        <% } else { %>
          <form action="/p/<%= p.id %>/mensaje" method="post" class="ask-form">
            <label>Pregúntale al vendedor
              <textarea name="body" rows="2" maxlength="1000" required placeholder="¿Tiene algún detalle? ¿Me mandas una foto de la etiqueta?"></textarea>
            </label>
            <button class="btn btn-ghost btn-block" type="submit">Enviar mensaje</button>
          </form>
        <% } %>
        <div class="protect">🛡️ <strong>Compra protegida:</strong> le pagas a CowFace y le pasamos el dinero al vendedor solo cuando confirmas que lo recibiste. Si no llega o no es como se describió, abres un reclamo. <a href="/como-funciona">Cómo funciona</a></div>
      </div>
    <% } %>

    <a class="seller-box" href="/u/<%= p.seller_id %>">
      <div class="avatar"><%= (p.store_name || '?').charAt(0).toUpperCase() %></div>
      <div class="seller-main">
        <strong><%= p.store_name %></strong><% if (p.featured) { %> <span class="featured-pill">Tienda destacada</span><% } %>
        <div class="small">
          <% if (sellerRating.count) { %><span class="stars"><%= stars(sellerRating.avg) %></span> <%= sellerRating.avg.toFixed(1) %> <span class="muted">(<%= sellerRating.count %>)</span><% } else { %><span class="muted">Sin reseñas todavía</span><% } %>
        </div>
        <div class="muted small"><%= p.province %><%= sellerSales.total ? ` · ${sellerSales.total} venta${sellerSales.total === 1 ? '' : 's'}` : '' %> · Ver perfil</div>
        <div class="status-line"><%- include('partials/presence', { presence: sellerPresence, hoursStatus: sellerHours }) %></div>
      </div>
      <span class="seller-arrow" aria-hidden="true">→</span>
    </a>

    <% if (sellerReviews.length) { %>
      <section class="review-comments">
        <h2 class="details-title">Lo que dicen de <%= p.store_name %></h2>
        <% for (const r of sellerReviews) { %>
          <div class="review-comment">
            <div class="small"><span class="stars"><%= stars(r.rating) %></span> <strong><%= r.author_display %></strong> <span class="muted">· <%= timeAgo(r.created_at) %></span></div>
            <p>«<%= r.comment %>»</p>
            <div class="muted small">Compró: <%= r.product_title %></div>
          </div>
        <% } %>
        <a class="small" href="/u/<%= p.seller_id %>#resenas">Ver todas las reseñas</a>
      </section>
    <% } %>

    <% if (!isOwner) { %><%- include('partials/report', { type: 'articulo', id: p.id, label: 'este artículo', back: `/p/${p.id}` }) %><% } %>

    <% if (measureList.length) { %>
      <h2 class="details-title">Medidas</h2>
      <dl class="specs measures">
        <% for (const m of measureList) { %>
          <div><dt><%= m.label %><% if (m.hint) { %><span class="measure-hint"><%= m.hint %></span><% } %></dt><dd><%= p.measurements[m.key] %> cm</dd></div>
        <% } %>
      </dl>
    <% } %>

    <h2 class="details-title">Detalles</h2>
    <dl class="specs">
      <% if (p.brand) { %><div><dt>Marca</dt><dd><%= p.brand %></dd></div><% } %>
      <div><dt>Tipo</dt><dd><%= p.item_type %></dd></div>
      <div><dt>Talla</dt><dd><%= p.size %></dd></div>
      <div><dt>Estado</dt><dd><%= catalog.CONDITIONS[p.condition] %></dd></div>
      <% if (p.color) { %><div><dt>Color</dt><dd><%= p.color %></dd></div><% } %>
      <div><dt>Para</dt><dd><%= catalog.DEPARTMENTS[p.department] %></dd></div>
      <div><dt>Disponibles</dt><dd><%= p.quantity %></dd></div>
    </dl>
    <% if (p.description) { %><p class="description"><%= p.description %></p><% } %>
  </div>
</div>
<%- include('partials/footer') %>
