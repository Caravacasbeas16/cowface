<%- include('../partials/header') %>
<% const canOffer = !blocked && conv.product_status === 'disponible' && !(conv.order && OPEN_STATUSES.includes(conv.order.status)); %>
<div class="chat" data-chat="<%= conv.id %>">
  <div class="chat-head">
    <a href="/mensajes" class="muted">← Mensajes</a>
    <div class="chat-who">
      <a href="/u/<%= otherId %>"><strong><%= conv.otherName %></strong></a>
      <span class="muted small"><%= conv.role === 'comprador' ? 'vendedor' : 'comprador' %></span>
      <% if (otherRating.count) { %><span class="small"><span class="stars"><%= stars(otherRating.avg) %></span> <%= otherRating.avg.toFixed(1) %></span><% } %>
      <span class="status-line"><%- include('../partials/presence', { presence: otherPresence, hoursStatus: otherHours }) %></span>
    </div>
    <% if (iBlocked) { %>
      <form action="/u/<%= otherId %>/desbloquear" method="post"><button class="linklike small">Desbloquear</button></form>
    <% } else { %>
      <form action="/u/<%= otherId %>/bloquear" method="post" data-confirm="¿Bloquear a <%= conv.otherName %>? No podrán escribirse ni hacer tratos nuevos. Los pedidos ya pagados siguen su curso.">
        <button class="linklike small">Bloquear</button>
      </form>
    <% } %>
  </div>

  <div class="chat-thread" data-thread>
    <%- include('thread') %>
  </div>

  <div class="composer">
    <% if (blocked) { %>
      <div class="notice"><%= iBlocked ? 'Bloqueaste a esta persona: no pueden escribirse ni hacer tratos nuevos.' : 'Esta persona te bloqueó: no pueden escribirse ni hacer tratos nuevos.' %> Si hay un pedido en curso, puedes seguir sus pasos desde el recuadro de arriba.</div>
    <% } else { %>
      <div class="alert" data-chat-error hidden></div>
      <form action="/mensajes/<%= conv.id %>" method="post" class="composer-text" data-chat-form>
        <label class="attach-btn" title="Enviar foto o PDF" aria-label="Enviar foto o PDF">
          📎<input type="file" accept="image/jpeg,image/png,image/webp,application/pdf" data-chat-file hidden>
        </label>
        <textarea name="body" rows="1" maxlength="1000" required placeholder="Escribe un mensaje…" aria-label="Mensaje"></textarea>
        <button class="btn" type="submit">Enviar</button>
      </form>
      <form action="/mensajes/<%= conv.id %>/adjunto" method="post" enctype="multipart/form-data" class="attach-form" data-attach-form hidden>
        <div class="attach-preview" data-attach-preview></div>
        <input name="body" maxlength="1000" placeholder="Agrega un texto (opcional)" aria-label="Texto de la foto">
        <div class="attach-actions">
          <button class="btn btn-small" type="submit" data-busy-text="Enviando…">Enviar archivo</button>
          <button class="btn btn-small btn-ghost" type="button" data-attach-cancel>Cancelar</button>
        </div>
        <p class="hint">Fotos o PDF de hasta <%= maxAttachMb %> MB: comprobantes, detalles de la prenda. Solo los ven ustedes dos (y CowFace si hay un reclamo).</p>
      </form>
    <% } %>
    <% if (canOffer) { %>
      <details class="composer-offer">
        <summary><%= conv.role === 'vendedor' ? 'Enviar contraoferta / oferta' : 'Hacer o mejorar mi oferta' %></summary>
        <form action="/mensajes/<%= conv.id %>/oferta" method="post" class="composer-text" data-chat-form>
          <% if (conv.role === 'comprador' && sizes.length) { %>
            <select name="size" required aria-label="Talla">
              <option value="">Talla…</option>
              <% for (const s of sizes) { %><option value="<%= s.size %>" <%= conv.chosen_size === s.size ? 'selected' : '' %> <%= s.quantity ? '' : 'disabled' %>><%= s.size %><%= s.quantity ? '' : ' (agotada)' %></option><% } %>
            </select>
          <% } %>
          <input name="amount" required inputmode="numeric" placeholder="Monto en ₡" aria-label="Monto de la oferta" autocomplete="off">
          <button class="btn btn-ghost" type="submit">Ofertar</button>
        </form>
        <p class="hint">
          Precio publicado <%= money(conv.price) %>.
          <% if (conv.role === 'comprador') { %>Oferta mínima <%= money(minOffer) %>.<% } %>
          Una oferta nueva reemplaza la anterior y vence en 48 horas.
        </p>
      </details>
    <% } %>
    <div class="push-cta" data-push-cta hidden>
      <span>🔔 Activa las notificaciones y entérate al instante cuando te escriban.</span>
      <button class="btn btn-small" type="button" data-push-enable>Activar</button>
    </div>
    <details class="help-panel">
      <summary>🛟 ¿Algún problema? Pedir ayuda a CowFace</summary>
      <form action="/mensajes/<%= conv.id %>/ayuda" method="post" class="stack compact">
        <textarea name="body" rows="3" required minlength="10" maxlength="1000" placeholder="Cuéntanos qué pasa: no responde, no llegó, algo no cuadra con el pago…"></textarea>
        <button class="btn btn-small">Pedir ayuda</button>
        <p class="hint">Si hay un problema con una compra, <strong>CowFace se hace cargo</strong>: revisamos la conversación y les respondemos por aquí. Solo lo leemos nosotros.</p>
      </form>
    </details>
    <%- include('../partials/report', { type: 'conversacion', id: conv.id, label: 'esta conversación o a la otra persona', back: `/mensajes/${conv.id}` }) %>
    <p class="hint center">🔒 No compartas teléfonos, redes sociales ni enlaces: el chat los bloquea. Paga siempre a CowFace: guardamos tu dinero hasta que recibas el artículo.</p>
  </div>
</div>
<%- include('../partials/footer') %>
