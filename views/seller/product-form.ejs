<%- include('../partials/header') %>
<%
  const f = form;
  const action = product ? `/vendedor/productos/${product.id}/editar` : '/vendedor/productos/nuevo';
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const err = (k) => errors[k] ? `<span class="error">${esc(errors[k])}</span>` : '';
  const existing = product ? product.images.length : 0;
%>
<section class="form-page">
  <% if (welcome) { %>
    <div class="notice notice-ok">¡Tu tienda está creada! Publica tu primer artículo.</div>
  <% } %>
  <h1><%= title %></h1>
  <% if (Object.keys(errors).length) { %><div class="alert">Revisa los campos marcados.</div><% } %>

  <% if (existing) { %>
    <p class="small muted">Fotos actuales. La primera es la portada.</p>
    <div class="current-photos">
      <% product.images.forEach((img, i) => { %>
        <div class="photo-tile <%= i === 0 ? 'is-cover' : '' %>">
          <img src="/fotos/<%= img.thumb %>" alt="Foto <%= i + 1 %>">
          <% if (i === 0) { %>
            <span class="cover-badge">Portada</span>
          <% } else { %>
            <form action="/vendedor/productos/<%= product.id %>/fotos/<%= img.id %>/portada" method="post">
              <button class="cover-btn" type="submit" title="Usar esta foto como portada">Usar de portada</button>
            </form>
          <% } %>
          <% if (existing > 1) { %>
            <form action="/vendedor/productos/<%= product.id %>/fotos/<%= img.id %>/borrar" method="post" data-confirm="¿Quitar esta foto?">
              <button class="remove-btn" type="submit" aria-label="Quitar foto" title="Quitar foto">×</button>
            </form>
          <% } %>
        </div>
      <% }) %>
    </div>
  <% } %>

  <form action="<%= action %>" method="post" enctype="multipart/form-data" class="stack" data-listing-form>
    <label><%= existing ? 'Agregar fotos' : 'Fotos' %>
      <span class="muted">(hasta <%= maxImages - existing %> más · JPG, PNG, WebP o AVIF · máx. <%= maxPhotoMb %> MB cada una)</span>
      <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/avif" multiple
             data-photo-input data-max="<%= maxImages - existing %>" data-max-mb="<%= maxPhotoMb %>" <%= existing ? '' : 'required' %>>
      <div class="photo-preview" data-photo-preview></div>
      <span class="error" data-photo-error hidden></span>
      <%- err('photos') %>
      <span class="hint">Se guardan en alta calidad. Quitamos la ubicación GPS de tus fotos para proteger tu privacidad. Tip: luz natural, fondo liso, y fotos de la etiqueta y de cualquier detalle.</span>
    </label>

    <label>Título
      <input name="title" required maxlength="100" value="<%= f.title || '' %>" placeholder="Ej. Camisa polo Lacoste azul marino">
      <%- err('title') %>
    </label>

    <div class="row3">
      <label>Categoría
        <select name="category" required data-category-select>
          <option value="">Elige…</option>
          <% for (const [key, c] of Object.entries(catalog.CATEGORIES)) { %>
            <option value="<%= key %>" <%= f.category === key ? 'selected' : '' %>><%= c.label %></option>
          <% } %>
        </select>
        <%- err('category') %>
      </label>
      <label>Tipo
        <select name="item_type" required data-type-select data-selected="<%= f.item_type || '' %>">
          <option value="">Elige categoría primero</option>
        </select>
        <%- err('item_type') %>
      </label>
      <label>Talla
        <select name="size" required data-size-select data-selected="<%= f.size || '' %>" data-placeholder="Elige…">
          <option value="">Elige categoría primero</option>
        </select>
        <%- err('size') %>
      </label>
    </div>

    <div class="row3">
      <label>Para
        <select name="department" required>
          <option value="">Elige…</option>
          <% for (const [key, label] of Object.entries(catalog.DEPARTMENTS)) { %>
            <option value="<%= key %>" <%= f.department === key ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select>
        <%- err('department') %>
      </label>
      <label>Estado
        <select name="condition" required>
          <option value="">Elige…</option>
          <% for (const [key, label] of Object.entries(catalog.CONDITIONS)) { %>
            <option value="<%= key %>" <%= f.condition === key ? 'selected' : '' %>><%= label %></option>
          <% } %>
        </select>
        <%- err('condition') %>
      </label>
      <label>Precio (₡)
        <input name="price" required inputmode="numeric" value="<%= f.price || '' %>" placeholder="15000">
        <%- err('price') %>
      </label>
    </div>

    <div class="row3">
      <label>Marca <span class="muted">(opcional)</span><input name="brand" maxlength="60" value="<%= f.brand || '' %>"></label>
      <label>Color <span class="muted">(opcional)</span><input name="color" maxlength="40" value="<%= f.color || '' %>"></label>
      <label>Cantidad
        <input type="number" name="quantity" min="1" max="999" required value="<%= f.quantity || 1 %>">
        <%- err('quantity') %>
      </label>
    </div>

    <label>Descripción <span class="muted">(opcional)</span>
      <textarea name="description" rows="4" maxlength="2000" placeholder="Medidas, detalles, si tiene algún defecto…"><%= f.description || '' %></textarea>
    </label>

    <div class="form-actions">
      <a class="btn btn-ghost" href="/vendedor">Cancelar</a>
      <button class="btn" type="submit" data-busy-text="Subiendo fotos…"><%= product ? 'Guardar cambios' : 'Publicar' %></button>
    </div>
  </form>
</section>
<%- include('../partials/footer') %>
