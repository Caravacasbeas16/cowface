<%- include('../partials/header') %>
<div class="page-head">
  <div>
    <h1><%= user.store_name || user.name %></h1>
    <p class="muted"><%= user.province %> · <%= user.email %> ·
      <% if (user.payout_phone) { %>Pagos a SINPE <%= user.payout_phone %> <a href="/vendedor/pagos">cambiar</a><% } else { %><a href="/vendedor/pagos">Agrega dónde recibir tus pagos</a><% } %></p>
  </div>
  <div class="head-actions">
    <a class="btn btn-ghost" href="/u/<%= user.id %>">Ver mi perfil público</a>
    <a class="btn" href="/vendedor/productos/nuevo">+ Publicar artículo</a>
  </div>
</div>
<% if (sellerState === 'pendiente') { %><div class="notice"><strong>Tu tienda está en revisión.</strong> Te avisamos por correo cuando la aprobemos; mientras tanto puedes ir subiendo artículos como borradores.</div><% } %>
<% if (sellerState === 'rechazado') { %><div class="notice">Tu tienda no está aprobada para vender en este momento. <a href="/vendedor/solicitud">Ver detalles</a></div><% } %>
<p class="small muted account-links"><a href="/bloqueados">Usuarios bloqueados</a> · <a href="/vendedor/pagos">Datos para recibir pagos</a></p>

<div class="stats">
  <div class="stat"><span class="stat-n"><%= stats.available %></span><span class="muted">Publicados</span></div>
  <a class="stat" href="/mensajes"><span class="stat-n"><%= stats.unreadSelling %></span><span class="muted">Chats de venta sin leer</span></a>
  <div class="stat <%= stats.toShip ? 'stat-warn' : '' %>"><span class="stat-n"><%= stats.toShip %></span><span class="muted">Pagadas · por enviar</span></div>
  <div class="stat"><span class="stat-n"><%= money(stats.soldTotal) %></span><span class="muted">Vendido (completado)</span></div>
  <div class="stat stat-accent"><span class="stat-n"><%= money(stats.payoutPending) %></span><span class="muted">Por recibir de CowFace</span></div>
</div>

<section id="mensajes">
  <div class="section-head">
    <h2>Mis mensajes</h2>
    <a class="btn btn-small btn-ghost" href="/mensajes">Ver todos</a>
  </div>
  <% if (!conversations.length) { %>
    <p class="muted">Todavía no tienes conversaciones. Cuando le escribas a un vendedor o alguien te escriba por una prenda, aparecen aquí.</p>
  <% } else { %>
    <div class="inbox">
      <% for (const c of conversations) { %>
        <a class="inbox-row <%= c.unread ? 'unread' : '' %>" href="/mensajes/<%= c.id %>">
          <img src="<%= c.product_id ? imageUrl({ id: c.product_id, category: c.category, image: c.image }) : '/sin-foto/x/0.svg' %>" alt="">
          <div class="inbox-main">
            <div class="inbox-top"><strong><%= c.other_name %></strong><span class="muted small"><%= when(c.last_message_at) %></span></div>
            <div class="muted small"><%= c.role === 'comprador' ? 'Le escribiste al vendedor' : 'Te escribieron' %> · <%= c.product_title %></div>
            <div class="inbox-last"><%= c.last_text && c.last_text.startsWith('Oferta: ') ? `Oferta: ${money(c.last_text.slice(8))}` : (c.last_text || '') %></div>
          </div>
          <% if (c.unread) { %><span class="dot" aria-label="Sin leer"></span><% } %>
        </a>
      <% } %>
    </div>
  <% } %>
</section>

<section id="ventas">
  <h2>Mis ventas</h2>
  <% if (!orders.length) { %>
    <p class="muted">Aún no tienes ventas. Cuando alguien compre o aceptes una oferta, aparece aquí.</p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Pedido</th><th>Artículo</th><th>Comprador</th><th>Precio</th><th>Recibes</th><th>Estado</th><th></th></tr></thead>
        <tbody>
          <% for (const o of orders) { %>
            <tr>
              <td><strong><%= o.code %></strong><div class="muted small"><%= when(o.created_at, true) %> · <%= o.source === 'oferta' ? 'oferta' : 'compra' %></div></td>
              <td><%= o.product_title %></td>
              <td><%= o.buyer_name %></td>
              <td><%= money(o.price) %></td>
              <td><%= money(o.payout_amount) %><% if (o.status === 'completado') { %><div class="muted small"><%= o.payout_status === 'pagado' ? 'transferido' : 'por transferir' %></div><% } %></td>
              <td><span class="status status-<%= o.status %>"><%= ORDER_STATUS[o.status] %></span></td>
              <td class="actions"><% if (o.conversation_id) { %><a class="btn btn-small <%= o.status === 'pagado' ? '' : 'btn-ghost' %>" href="/mensajes/<%= o.conversation_id %>"><%= o.status === 'pagado' ? 'Enviar' : 'Ver' %></a><% } %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section id="articulos">
  <h2>Mis artículos</h2>
  <% if (!products.length) { %>
    <div class="empty">
      <p>Todavía no has publicado nada.</p>
      <a class="btn" href="/vendedor/productos/nuevo">Publicar mi primer artículo</a>
    </div>
  <% } else { %>
    <% if (stats.drafts) { %><p class="small muted">Tienes <%= stats.drafts %> borrador<%= stats.drafts === 1 ? '' : 'es' %> sin publicar: nadie los ve hasta que los publiques.</p><% } %>
    <div class="list">
      <% for (const p of products) { %>
        <div class="list-row">
          <img src="<%= imageUrl(p) %>" alt="">
          <div class="list-main">
            <a href="<%= p.status === 'borrador' ? `/vendedor/productos/${p.id}/editar` : `/p/${p.id}` %>"><strong><%= p.title %></strong></a>
            <div class="muted small">Talla <%= p.size %> · <%= money(p.price) %> · <%= p.quantity %> disp.</div>
            <span class="status status-<%= p.status %>"><%= PRODUCT_STATUS[p.status] %></span>
            <% if (['disponible', 'pausado', 'vendido'].includes(p.status)) { %>
              <form action="/vendedor/productos/<%= p.id %>/rapido" method="post" class="quick-edit">
                <label>Precio ₡<input name="price" inputmode="numeric" value="<%= p.price %>" aria-label="Precio de <%= p.title %>"></label>
                <label>Cant.<input name="quantity" type="number" min="0" max="999" value="<%= p.quantity %>" aria-label="Cantidad de <%= p.title %>"></label>
                <button class="btn btn-small btn-ghost">Guardar</button>
              </form>
            <% } %>
          </div>
          <div class="list-actions">
            <a class="btn btn-small <%= p.status === 'borrador' ? '' : 'btn-ghost' %>" href="/vendedor/productos/<%= p.id %>/editar"><%= p.status === 'borrador' ? 'Terminar y publicar' : 'Editar' %></a>
            <% if (p.status === 'disponible' || p.status === 'pausado') { %>
              <form action="/vendedor/productos/<%= p.id %>/estado" method="post" class="inline">
                <% if (p.status === 'disponible') { %>
                  <button class="btn btn-small btn-ghost" name="status" value="pausado">Pausar</button>
                <% } else { %>
                  <button class="btn btn-small btn-ghost" name="status" value="disponible">Reactivar</button>
                <% } %>
              </form>
            <% } %>
            <form action="/vendedor/productos/<%= p.id %>/borrar" method="post" class="inline" data-confirm="¿Borrar este artículo? No se puede deshacer.">
              <button class="btn btn-small btn-danger">Borrar</button>
            </form>
          </div>
        </div>
      <% } %>
    </div>
  <% } %>
</section>

<section id="compras">
  <h2>Mis compras</h2>
  <% if (!purchases.length) { %>
    <p class="muted">Aún no has comprado nada. <a href="/buscar">Explorar artículos</a></p>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Pedido</th><th>Artículo</th><th>Vendedor</th><th>Precio</th><th>Estado</th><th></th></tr></thead>
        <tbody>
          <% for (const o of purchases) { %>
            <tr>
              <td><strong><%= o.code %></strong><div class="muted small"><%= when(o.created_at, true) %></div></td>
              <td><%= o.product_title %></td>
              <td><%= o.store_name %></td>
              <td><%= money(o.price) %></td>
              <td><span class="status status-<%= o.status %>"><%= ORDER_STATUS[o.status] %></span></td>
              <td><% if (o.conversation_id) { %><a class="btn btn-small btn-ghost" href="/mensajes/<%= o.conversation_id %>">Chat</a><% } %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section id="avisos">
  <h2>Mis avisos</h2>
  <% if (!searches.length) { %>
    <p class="muted">No tienes avisos. En cualquier búsqueda toca <strong>"Avísame cuando haya"</strong> y te mandamos un correo cuando se publique algo que coincida.</p>
  <% } else { %>
    <div class="list">
      <% for (const s of searches) { %>
        <div class="list-row">
          <div class="list-main">
            <a href="/buscar?<%= s.query %>"><strong><%= s.label %></strong></a>
            <div class="muted small">Creado <%= timeAgo(s.created_at) %><%= s.last_notified_at ? ` · último aviso ${timeAgo(s.last_notified_at)}` : '' %></div>
          </div>
          <form action="/vendedor/avisos/<%= s.id %>/borrar" method="post" class="inline">
            <button class="btn btn-small btn-ghost">Borrar aviso</button>
          </form>
        </div>
      <% } %>
    </div>
  <% } %>
</section>

<section id="celular" class="push-panel" data-push-panel>
  <h2>Notificaciones en el celular</h2>
  <p class="muted">Te llega un aviso como el de una app cuando te escriben, te hacen una oferta o cambia un pedido.</p>
  <div data-state="off">
    <button class="btn" type="button" data-push-enable>🔔 Activar en este dispositivo</button>
    <p class="hint">Tu celular te va a preguntar si permites notificaciones: toca <strong>Permitir</strong>. Actívalas en cada celular o computadora donde uses CowFace.</p>
  </div>
  <div data-state="on" hidden>
    <p><strong>✓ Activadas en este dispositivo.</strong></p>
    <div class="push-actions">
      <button class="btn btn-small" type="button" data-push-test>Mandarme una de prueba</button>
      <button class="btn btn-small btn-ghost" type="button" data-push-disable>Desactivar aquí</button>
    </div>
  </div>
  <div data-state="ios" hidden>
    <p><strong>En iPhone se activan desde el ícono de CowFace:</strong></p>
    <ol class="push-steps">
      <li>Abre esta página en <strong>Safari</strong>.</li>
      <li>Toca el botón <strong>Compartir</strong> (el cuadrito con la flecha hacia arriba).</li>
      <li>Elige <strong>"Agregar a pantalla de inicio"</strong> y toca <strong>Agregar</strong>.</li>
      <li>Abre CowFace <strong>desde ese ícono</strong>, entra a Mi cuenta y toca "Activar".</li>
    </ol>
    <p class="hint">Necesitas iOS 16.4 o más reciente. Así lo exige Apple para cualquier sitio web.</p>
  </div>
  <div data-state="denied" hidden>
    <p><strong>Las notificaciones están bloqueadas para CowFace en este navegador.</strong></p>
    <p class="hint">Para activarlas: en Android, toca el candado junto a la dirección → Permisos → Notificaciones → Permitir. En iPhone: Ajustes → Notificaciones → CowFace. Después recarga esta página.</p>
  </div>
  <div data-state="unsupported" hidden>
    <p class="muted">Este navegador no permite notificaciones. Prueba con Chrome en Android o en la computadora. Igual te avisamos por correo.</p>
  </div>
  <p class="hint" data-push-msg hidden></p>
</section>

<section id="avisos-correo">
  <h2>Avisos por correo</h2>
  <form action="/vendedor/avisos-correo" method="post" class="stack notify-form">
    <label class="check">
      <input type="checkbox" name="email_messages" value="1" <%= user.email_messages ? 'checked' : '' %>>
      <span>Mandarme un correo a <strong><%= user.email %></strong> cuando un comprador me escriba y no lo haya leído en <%= emailWait %> minutos (máximo uno por conversación cada hora).</span>
    </label>
    <button class="btn btn-small">Guardar</button>
  </form>
</section>
<%- include('../partials/footer') %>
