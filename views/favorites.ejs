<%- include('partials/header') %>
<div class="page-head">
  <div>
    <h1>Favoritos</h1>
    <p class="muted">Lo que guardaste con ♥. Si una tienda le baja el precio, te avisamos en el celular y por correo.</p>
  </div>
  <a class="btn btn-ghost btn-small" href="/siguiendo">Tiendas que sigo</a>
</div>
<% if (!items.length) { %>
  <div class="empty">
    <p>Todavía no guardaste nada.</p>
    <p class="muted small">Toca el ♥ en cualquier artículo para guardarlo aquí.</p>
    <a class="btn" href="/buscar">Explorar</a>
  </div>
<% } else { %>
  <div class="grid">
    <% for (const p of items) { %>
      <% if (p.status === 'disponible') { %>
        <%- include('partials/card', { p }) %>
      <% } else { %>
        <div class="card-wrap is-gone">
          <a class="card" href="/p/<%= p.id %>">
            <div class="card-img"><img src="<%= imageUrl(p) %>" alt="<%= p.title %>" loading="lazy"><span class="tag"><%= p.status === 'vendido' ? 'Vendido' : 'No disponible' %></span></div>
            <div class="card-body"><div class="card-brand"><%= p.brand || p.item_type %></div><div class="card-title"><%= p.title %></div><div class="card-price"><%= money(p.price) %></div></div>
          </a>
          <form action="/p/<%= p.id %>/favorito" method="post" class="fav-form" data-fav>
            <button class="fav-btn is-on" aria-pressed="true" aria-label="Quitar de favoritos" title="Quitar de favoritos"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg></button>
          </form>
        </div>
      <% } %>
    <% } %>
  </div>
<% } %>
<%- include('partials/footer') %>
